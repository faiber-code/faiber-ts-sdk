diff --git a/Dockerfile b/Dockerfile
index abf1357..53a7920 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,5 +1,7 @@
-# Rust deps cached via cargo-chef. panel/ is excluded from Rust COPY layers so
-# frontend-only commits do not invalidate the cargo build step.
+# Build the real locked workspace directly. cargo-chef masks local crate versions
+# but leaves version-qualified vendored dependency references in its synthetic
+# lockfile. Keep Cargo.lock authoritative and reuse registry/git/target caches.
+# panel/ remains outside Rust COPY layers.
 FROM lukemathwalker/cargo-chef:0.1.78-rust-1.98.1 AS chef
 ARG CARGO_REGISTRY=sparse+https://index.crates.io/
 ENV CARGO_HTTP_TIMEOUT=120 \
@@ -15,21 +17,7 @@ RUN set -eu; \
     fi
 WORKDIR /usr/src/app
 
-FROM chef AS planner
-COPY Cargo.toml Cargo.lock* ./
-COPY shared shared
-COPY src src
-COPY entity entity
-COPY migration migration
-RUN cargo chef prepare --recipe-path recipe.json
-
 FROM chef AS builder
-COPY shared shared
-COPY --from=planner /usr/src/app/recipe.json recipe.json
-RUN --mount=type=cache,id=infera-lms-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
-    --mount=type=cache,id=infera-lms-cargo-git,target=/usr/local/cargo/git,sharing=locked \
-    --mount=type=cache,id=infera-lms-cargo-target,target=/usr/src/app/target,sharing=locked \
-    cargo chef cook --release --locked --recipe-path recipe.json
 COPY Cargo.toml Cargo.lock* ./
 COPY shared shared
 COPY src src
