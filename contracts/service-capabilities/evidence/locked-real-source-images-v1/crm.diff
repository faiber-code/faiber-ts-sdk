+# caches remain available, and panel inputs stay outside Rust COPY layers.
 FROM lukemathwalker/cargo-chef:0.1.73-rust-1.92.0 AS chef
 ARG CARGO_REGISTRY=sparse+https://index.crates.io/
 ENV CARGO_HTTP_TIMEOUT=120 \
@@ -24,21 +25,7 @@ RUN set -e; \
     fi
