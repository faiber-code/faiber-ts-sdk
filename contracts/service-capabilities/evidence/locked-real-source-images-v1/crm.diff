-COPY shared shared
-RUN --mount=type=cache,id=infera-crm-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
-    --mount=type=cache,id=infera-crm-cargo-git,target=/usr/local/cargo/git,sharing=locked \
-    --mount=type=cache,id=infera-crm-cargo-target,target=/usr/src/app/target,sharing=locked \
-    cargo chef cook --release --locked --recipe-path recipe.json
