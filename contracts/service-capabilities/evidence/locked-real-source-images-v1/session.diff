diff --git a/Dockerfile b/Dockerfile
index 1a4f1fa..8deaac5 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,5 +1,6 @@
-# Rust deps cached via cargo-chef. panel/ is excluded from Rust COPY layers so
-# frontend-only commits do not invalidate the cargo build step.
+# Build the real locked workspace directly; synthetic local crate version
+# masking breaks qualified vendored dependency references. Registry/git/target
+# caches remain available, and panel inputs stay outside Rust COPY layers.
 FROM rust:1.92.0 AS chef
 ENV TZ=Asia/Tehran
 ENV APP_TIMEZONE=Asia/Tehran
@@ -20,25 +21,9 @@ RUN set -e; \
         "registry = \"${REG}\"" \
         > "$CARGO_HOME/config.toml"; \
     fi
-RUN cargo install cargo-chef --locked
 WORKDIR /usr/src/app
 
-FROM chef AS planner
-COPY Cargo.toml Cargo.lock* ./
-COPY shared shared
-COPY src src
-COPY chat chat
-COPY entity entity
-COPY migration migration
-RUN cargo chef prepare --recipe-path recipe.json
-
 FROM chef AS builder
-COPY shared shared
-COPY --from=planner /usr/src/app/recipe.json recipe.json
-RUN --mount=type=cache,id=infera-session-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
-    --mount=type=cache,id=infera-session-cargo-git,target=/usr/local/cargo/git,sharing=locked \
-    --mount=type=cache,id=infera-session-cargo-target,target=/usr/src/app/target,sharing=locked \
-    cargo chef cook --release --recipe-path recipe.json
 COPY Cargo.toml Cargo.lock* ./
 COPY shared shared
 COPY src src
@@ -49,7 +34,7 @@ RUN --mount=type=cache,id=infera-session-cargo-registry,target=/usr/local/cargo/
     --mount=type=cache,id=infera-session-cargo-git,target=/usr/local/cargo/git,sharing=locked \
     --mount=type=cache,id=infera-session-cargo-target,target=/usr/src/app/target,sharing=locked \
     find src chat entity migration -type f -name '*.rs' -exec touch {} + && \
-    cargo build --release && \
+    cargo build --release --locked && \
     strip target/release/mra_session && \
     cp target/release/mra_session /usr/local/bin/mra_session
