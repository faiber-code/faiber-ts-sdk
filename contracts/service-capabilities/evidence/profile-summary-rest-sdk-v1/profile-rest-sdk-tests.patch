+#!/usr/bin/env bash
+# Real mounted Profile/compiled SDK acceptance. Disposable local dependencies only.
+set -euo pipefail
+repo="$(cd "$(dirname "$0")/.." && pwd)"
+: "${SUMMARY_SDK_PACKAGE_ENTRY:?Set this to the isolated compiled @faiber/faiber-profile dist/index.js}"
+project="profile-rest-sdk-$$"
+compose=(docker compose -p "$project" -f "$repo/tests/summary-services.compose.yml")
+trap '"${compose[@]}" down --remove-orphans' EXIT
+"${compose[@]}" up -d --wait --pull never
+pg_port="$("${compose[@]}" port postgres 5432 | sed 's/.*://')"
+rmq_port="$("${compose[@]}" port rabbitmq 5672 | sed 's/.*://')"
+export SUMMARY_TEST_DATABASE_URL="postgres://postgres:summary-test@127.0.0.1:$pg_port/summary_test"
+export SUMMARY_TEST_BROKER_URL="amqp://guest:guest@127.0.0.1:$rmq_port/%2f"
+export SUMMARY_SDK_CONSUMER="$repo/tests/summary-rest-sdk.mjs"
+cargo test --manifest-path "$repo/Cargo.toml" --locked --offline --test summary_rest_sdk -- --ignored --nocapture
