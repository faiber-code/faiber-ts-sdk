+++ b/tests/run-summary-native.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+set -euo pipefail
+repo="$(cd "$(dirname "$0")/.." && pwd)"
+name="summary-native-chat-$$"
+docker run --pull never -d --name "$name" -e POSTGRES_PASSWORD=summary-test -e POSTGRES_DB=summary_test -p 127.0.0.1::5432 --tmpfs /var/lib/postgresql/data postgres:16-alpine >/dev/null
+trap 'docker rm -f "$name" >/dev/null' EXIT
+for step in {1..30}; do docker exec "$name" pg_isready -U postgres >/dev/null 2>&1 && break; sleep 1; done
+port="$(docker port "$name" 5432/tcp | sed 's/.*://')"
+export SUMMARY_TEST_DATABASE_URL="postgres://postgres:summary-test@127.0.0.1:$port/summary_test"
+CARGO_INCREMENTAL=0 CARGO_BUILD_JOBS=2 cargo test --manifest-path "$repo/tests/summary-native/Cargo.toml" --locked --offline -- --nocapture --test-threads=1
