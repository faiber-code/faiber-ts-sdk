+use sea_orm_migration::prelude::*;
+#[derive(DeriveMigrationName)]
+pub struct Migration;
+#[async_trait::async_trait]
+impl MigrationTrait for Migration {
+    async fn up(&self, m: &SchemaManager) -> Result<(), DbErr> {
+        m.get_connection()
+            .execute_unprepared(include_str!(
+                "../../shared/infera-summary-sdk/src/outbox.sql"
+            ))
+            .await?;
+        m.get_connection().execute_unprepared(r#"CREATE TRIGGER summary_activity_chat_response_timing AFTER INSERT OR UPDATE OR DELETE ON chat_messages FOR EACH ROW EXECUTE FUNCTION summary_activity_capture('chat','response_timing');
+CREATE TRIGGER summary_activity_chat_conversations AFTER INSERT OR UPDATE OR DELETE ON chat_conversations FOR EACH ROW EXECUTE FUNCTION summary_activity_capture('chat','conversations');
+CREATE TRIGGER summary_activity_chat_conversation_members AFTER INSERT OR UPDATE OR DELETE ON chat_conversation_members FOR EACH ROW EXECUTE FUNCTION summary_activity_capture('chat','conversations');
+CREATE TRIGGER summary_activity_chat_message_text AFTER INSERT OR UPDATE OR DELETE ON chat_messages FOR EACH ROW EXECUTE FUNCTION summary_activity_capture('chat','messages');
+CREATE TRIGGER summary_activity_chat_messages AFTER INSERT OR UPDATE OR DELETE ON chat_messages FOR EACH ROW EXECUTE FUNCTION summary_activity_capture('chat','activity');"#).await?;
+        Ok(())
+    }
+    async fn down(&self, _: &SchemaManager) -> Result<(), DbErr> {
+        Err(DbErr::Custom(
+            "Retain summary outbox during application rollback".into(),
+        ))
+    }
+}
