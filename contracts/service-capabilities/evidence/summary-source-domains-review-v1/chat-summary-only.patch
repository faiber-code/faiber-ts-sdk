+    #[allow(unsafe_code)]
+    #[ref_cast_custom]
+    fn ref_cast(value: &Value) -> &Self;
+
+    #[allow(unsafe_code)]
+    #[ref_cast_custom]
+    fn ref_cast_mut(value: &mut Value) -> &mut Self;
+}
