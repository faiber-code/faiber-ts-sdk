+#![cfg(feature = "server")]
+use base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine};
+use ed25519_dalek::SigningKey;
+use infera_summary_sdk::rmcp::{
+    model::CallToolRequestParam,
+    transport::{
+        streamable_http_client::StreamableHttpClientTransportConfig, StreamableHttpClientTransport,
+    },
+    ServiceExt,
+};
+use infera_summary_sdk::server::{self, EvidenceReader};
+use infera_summary_sdk::*;
+use serde_json::json;
+use uuid::Uuid;
+#[derive(Clone)]
+struct Fixture(Source);
+impl EvidenceReader for Fixture {
+    fn source(&self) -> Source {
+        self.0
+    }
+    async fn read(
+        &self,
+        g: EvidenceGrant,
+        _: String,
+        _: ActivityArguments,
+    ) -> Result<EvidenceEnvelope, String> {
+        Ok(EvidenceEnvelope {
+            contract_version: "1".into(),
+            source: self.0,
+            subject_user_id: g.subject_user_id,
+            scope: g.scope,
+            window_start: g.window_start,
+            cutoff: g.cutoff,
+            coverage: Coverage {
+                source: self.0,
+                status: CoverageStatus::Empty,
+                revision: "empty".into(),
+                reason: None,
+                record_count: 0,
+            },
+            aggregates: Default::default(),
+            records: vec![],
+            next_cursor: None,
+            truncated: false,
+        })
+    }
+}
+fn grant(source: Source) -> EvidenceGrant {
+    let now = chrono::Utc::now();
+    EvidenceGrant {
+        iss: "infera-profile".into(),
+        aud: source,
+        deployment_id: "summary-transport-test".into(),
+        service_user_id: Uuid::from_u128(2),
+        subject_user_id: Uuid::from_u128(1),
+        role_id: Uuid::from_u128(3),
+        run_id: Uuid::from_u128(4),
+        config_revision: 1,
+        tools: vec!["get_activity_overview".into()],
+        categories: vec![source_capabilities()
+            .into_iter()
+            .find(|s| s.source == source)
+            .unwrap()
+            .categories[0]
+            .clone()],
+        scope: Scope::Subject,
+        allow_text: false,
+        window_start: now - chrono::Duration::days(30),
+        cutoff: now,
+        native_scope_id: None,
+        iat: now.timestamp(),
+        exp: now.timestamp() + 120,
+    }
+}
+#[tokio::test]
+async fn streamable_http_is_scoped_for_every_source() {
+    let key = SigningKey::from_bytes(&[11; 32]);
+    let secret = URL_SAFE_NO_PAD.encode(key.to_bytes());
+    std::env::set_var(
+        "SUMMARY_VERIFYING_KEY",
+        URL_SAFE_NO_PAD.encode(key.verifying_key().to_bytes()),
+    );
+    std::env::set_var("SUMMARY_DEPLOYMENT_ID", "summary-transport-test");
+    std::env::set_var("SUMMARY_SERVICE_USER_ID", Uuid::from_u128(2).to_string());
+    for source in Source::ALL {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}/mcp", listener.local_addr().unwrap());
+        let task = tokio::spawn(async move {
+            axum::serve(listener, server::router(Fixture(source)))
+                .await
+                .unwrap();
+        });
+        let g = grant(source);
+        let token = sign_grant(&g, &secret).unwrap();
+        let transport = StreamableHttpClientTransport::with_client(
+            reqwest::Client::new(),
+            StreamableHttpClientTransportConfig::with_uri(url.clone()).auth_header(token.clone()),
+        );
+        let client = ().serve(transport).await.unwrap();
+        let tools = client.list_all_tools().await.unwrap();
+        assert_eq!(tools.len(), 4);
+        assert!(tools.iter().all(|t| t.output_schema.is_some()));
+        let response = client
+            .call_tool(CallToolRequestParam {
+                name: "get_activity_overview".into(),
+                arguments: Some(json!({}).as_object().unwrap().clone()),
+            })
+            .await
+            .unwrap();
+        let envelope: EvidenceEnvelope =
+            serde_json::from_value(response.structured_content.unwrap()).unwrap();
+        assert_eq!(envelope.subject_user_id, g.subject_user_id);
+        assert_eq!(envelope.source, source);
+        let forbidden = client
+            .call_tool(CallToolRequestParam {
+                name: "list_activity".into(),
+                arguments: Some(json!({}).as_object().unwrap().clone()),
+            })
+            .await
+            .unwrap();
+        assert_eq!(forbidden.is_error, Some(true));
+        let forged = client
+            .call_tool(CallToolRequestParam {
+                name: "get_activity_overview".into(),
+                arguments: Some(
+                    json!({"subject_user_id":Uuid::new_v4()})
+                        .as_object()
+                        .unwrap()
+                        .clone(),
+                ),
+            })
+            .await;
+        assert!(forged.is_err());
+        client.cancel().await.unwrap();
+        for mutation in 0..3 {
+            let mut invalid = g.clone();
+            match mutation {
+                0 => invalid.deployment_id = "other".into(),
+                1 => invalid.exp = chrono::Utc::now().timestamp() - 1,
+                _ => {
+                    invalid.aud = if source == Source::Chat {
+                        Source::Lms
+                    } else {
+                        Source::Chat
+                    }
+                }
+            }
+            let token = sign_grant(&invalid, &secret).unwrap();
+            assert_eq!(
+                reqwest::Client::new()
+                    .post(&url)
+                    .bearer_auth(token)
+                    .json(&json!({"jsonrpc":"2.0","id":1,"method":"initialize"}))
+                    .send()
+                    .await
+                    .unwrap()
+                    .status(),
+                401
+            );
+        }
+        assert_eq!(
+            reqwest::Client::new()
+                .post(&url)
+                .bearer_auth(token)
+                .header("origin", "http://untrusted.test")
+                .send()
+                .await
+                .unwrap()
+                .status(),
+            403
+        );
+        task.abort();
+    }
+}
+#[tokio::test]
+#[ignore = "requires the local accounting server and SUMMARY_ACCOUNTING_TEST_URL"]
+async fn official_rust_client_negotiates_with_laravel_mcp() {
+    let url = std::env::var("SUMMARY_ACCOUNTING_TEST_URL").expect("accounting test URL");
+    let key = SigningKey::from_bytes(&[11; 32]);
+    let token = sign_grant(
+        &grant(Source::Accounting),
+        &URL_SAFE_NO_PAD.encode(key.to_bytes()),
+    )
+    .unwrap();
+    let transport = StreamableHttpClientTransport::with_client(
+        reqwest::Client::new(),
+        StreamableHttpClientTransportConfig::with_uri(url).auth_header(token),
+    );
+    let client = ().serve(transport).await.unwrap();
+    let tools = client.list_all_tools().await.unwrap();
+    assert_eq!(tools.len(), 4);
+    assert!(tools.iter().all(|t| t.output_schema.is_some()));
+    client.cancel().await.unwrap();
+}
+
+#[tokio::test]
+#[ignore = "requires dedicated SUMMARY_TEST_DATABASE_URL; read-only SQL fixture"]
+async fn postgres_evidence_hashes_complete_results_and_paginates() {
+    let url = std::env::var("SUMMARY_TEST_DATABASE_URL").unwrap();
+    assert!(url.contains("summary_test"));
+    let db = sea_orm::Database::connect(url).await.unwrap();
+    let mut g = grant(Source::Task);
+    g.categories = vec!["work_items".into()];
+    let domain="SELECT id::text,'work_items'::text AS category,'v1'::text AS version,$6::timestamptz-interval '1 day' AS occurred_at,jsonb_build_object('amount',amount) AS data FROM (VALUES ('a','9007199254740993.01'),('b','0.09')) AS fixture(id,amount)";
+    let aggregate="SELECT 'task.work_items.amount'::text AS key,to_jsonb(sum((data->>'amount')::numeric)::text) AS value FROM scoped";
+    let first = infera_summary_sdk::query::evidence_with_aggregates(
+        &db,
+        &g,
+        "list_activity",
+        ActivityArguments {
+            limit: 1,
+            ..serde_json::from_value::<ActivityArguments>(json!({})).unwrap()
+        },
+        domain,
+        aggregate,
+    )
+    .await
+    .unwrap();
+    assert_eq!(first.coverage.record_count, 2);
+    assert_eq!(
+        first.aggregates["task.work_items.amount"],
+        "9007199254740993.10"
+    );
+    assert_eq!(first.records.len(), 1);
+    assert!(first.truncated);
+    let second = infera_summary_sdk::query::evidence_with_aggregates(
+        &db,
+        &g,
+        "list_activity",
+        ActivityArguments {
+            limit: 1,
+            cursor: first.next_cursor.clone(),
+            ..serde_json::from_value::<ActivityArguments>(json!({})).unwrap()
+        },
+        domain,
+        aggregate,
+    )
+    .await
+    .unwrap();
+    assert_eq!(second.records.len(), 1);
+    assert!(!second.truncated);
+    assert_ne!(first.records[0].id, second.records[0].id);
+    assert_eq!(first.coverage.revision, second.coverage.revision);
+    let changed = infera_summary_sdk::query::evidence_with_aggregates(
+        &db,
+        &g,
+        "get_activity_overview",
+        serde_json::from_value::<ActivityArguments>(json!({})).unwrap(),
+        &domain.replace("0.09", "0.10"),
+        aggregate,
+    )
+    .await
+    .unwrap();
+    assert_ne!(first.coverage.revision, changed.coverage.revision);
+    db.close().await.unwrap();
+}
