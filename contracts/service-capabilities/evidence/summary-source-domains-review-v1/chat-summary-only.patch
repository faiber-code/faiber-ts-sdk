+        #[serde(rename_all = "camelCase")]
+        #[cfg_attr(feature = "schemars", derive(schemars::JsonSchema))]
+        pub struct $t {
+            #[serde(skip_serializing_if = "Option::is_none")]
+            pub next_cursor: Option<Cursor>,
+            pub $i_item: $t_item,
+        }
+
+        impl $t {
+            pub fn with_all_items(
+                items: $t_item,
+            ) -> Self {
+                Self {
+                    next_cursor: None,
+                    $i_item: items,
+                }
+            }
+        }
+    };
