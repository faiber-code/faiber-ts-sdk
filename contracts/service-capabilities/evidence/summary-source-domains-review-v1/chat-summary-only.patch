+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct PreviewRequest {
+    pub user_id: Uuid,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct PreviewResponse {
+    pub job_id: Uuid,
+    pub run_id: Uuid,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct StatusRequest {
+    pub enabled: bool,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct Validation {
+    pub valid: bool,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct SourceCheck {
+    pub source: Source,
+    pub available: bool,
+}
