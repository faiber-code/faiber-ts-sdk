+    /// This always returns `None` for bool schemas.
+    ///
+    /// # Example
+    /// ```
+    /// use schemars::json_schema;
+    /// use serde_json::json;
+    ///
+    /// let obj_schema = json_schema!({"type": "array"});
+    /// assert_eq!(obj_schema.get("type"), Some(&json!("array")));
+    /// assert_eq!(obj_schema.get("format"), None);
