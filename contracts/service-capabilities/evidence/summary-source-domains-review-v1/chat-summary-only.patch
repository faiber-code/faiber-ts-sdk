@@ -0,0 +1,488 @@
+use crate::{Formula, MetricType};
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet};
+use uuid::Uuid;
+
+pub type Localized = BTreeMap<String, String>;
+
+#[derive(
+    schemars::JsonSchema, Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq, PartialOrd, Ord,
+)]
+#[serde(rename_all = "snake_case")]
+pub enum Source {
+    Lms,
+    Task,
+    Accounting,
+    Session,
+    Chat,
+    Crm,
+}
+impl Source {
+    pub const ALL: [Self; 6] = [
+        Self::Lms,
+        Self::Task,
+        Self::Accounting,
+        Self::Session,
+        Self::Chat,
+        Self::Crm,
+    ];
+    pub fn key(self) -> &'static str {
+        match self {
+            Self::Lms => "lms",
+            Self::Task => "task",
+            Self::Accounting => "accounting",
+            Self::Session => "session",
+            Self::Chat => "chat",
+            Self::Crm => "crm",
+        }
+    }
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum Scope {
+    Subject,
+    Assigned,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SourceSelection {
+    pub source: Source,
+    pub required: bool,
+    pub scope: Scope,
+    pub categories: Vec<String>,
+    #[serde(default)]
+    pub tools: Vec<String>,
+    #[serde(default)]
+    pub allow_text: bool,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct AggregateRef {
+    pub source: Source,
+    pub category: String,
+    pub key: String,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "mode", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Calculation {
+    Aggregate {
+        aggregate: AggregateRef,
+    },
+    Formula {
+        expression: Formula,
+    },
+    Assessment {
+        instructions: String,
+        rubric: Vec<RubricAnchor>,
+        dependencies: Vec<Source>,
+    },
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RubricAnchor {
+    pub value: serde_json::Value,
+    pub description: String,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MetricDefinition {
+    pub key: String,
+    pub label: Localized,
+    pub description: Localized,
+    pub value_type: MetricType,
+    pub unit: String,
+    pub min: Option<String>,
+    pub max: Option<String>,
+    #[serde(default)]
+    pub enum_values: Vec<String>,
+    pub calculation: Calculation,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum SectionFormat {
+    Paragraph,
+    Bullets,
+    Actions,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SectionDefinition {
+    pub key: String,
+    pub title: Localized,
+    pub instructions: String,
+    pub format: SectionFormat,
+    pub max_chars: u32,
+    pub max_items: u16,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct RefreshPolicy {
+    pub activity: bool,
+    pub quiet_minutes: u32,
+    pub max_wait_minutes: u32,
+    pub scheduled: bool,
+    pub daily_at: String,
+    pub timezone: String,
+}
+impl Default for RefreshPolicy {
+    fn default() -> Self {
+        Self {
+            activity: true,
+            quiet_minutes: 10,
+            max_wait_minutes: 60,
+            scheduled: true,
+            daily_at: "03:00".into(),
+            timezone: "Asia/Tehran".into(),
+        }
+    }
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct Budgets {
+    pub tool_calls: u32,
+    pub model_rounds: u32,
+    pub timeout_seconds: u32,
+    pub max_input_tokens: u32,
+    pub max_output_tokens: u32,
+}
+impl Default for Budgets {
+    fn default() -> Self {
+        Self {
+            tool_calls: 40,
+            model_rounds: 12,
+            timeout_seconds: 300,
+            max_input_tokens: 64000,
+            max_output_tokens: 8000,
+        }
+    }
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct SummaryConfiguration {
+    pub role_id: Uuid,
+    pub language: String,
+    pub model_ref: String,
+    pub guidance: String,
+    pub lookback_days: u32,
+    pub sources: Vec<SourceSelection>,
+    pub metrics: Vec<MetricDefinition>,
+    pub sections: Vec<SectionDefinition>,
+    pub refresh: RefreshPolicy,
+    pub budgets: Budgets,
+}
+impl Default for SummaryConfiguration {
+    fn default() -> Self {
+        Self {
+            role_id: Uuid::nil(),
+            language: "fa".into(),
+            model_ref: String::new(),
+            guidance: String::new(),
+            lookback_days: 30,
+            sources: vec![],
+            metrics: vec![],
+            sections: vec![],
+            refresh: RefreshPolicy::default(),
+            budgets: Budgets::default(),
+        }
+    }
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct AggregateCapability {
+    pub key: String,
+    pub category: String,
+    pub unit: String,
+    pub value_type: MetricType,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct SourceCapability {
+    pub source: Source,
+    pub categories: Vec<String>,
+    pub text_categories: Vec<String>,
+    pub scopes: Vec<Scope>,
+    pub tools: Vec<String>,
+    pub aggregates: Vec<AggregateCapability>,
+}
+
+fn valid_key(key: &str) -> bool {
+    !key.is_empty()
+        && key.len() <= 64
+        && key
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'_')
+}
+pub fn validate_configuration(
+    c: &SummaryConfiguration,
+    capabilities: &[SourceCapability],
+) -> Result<(), Vec<String>> {
+    let mut errors = vec![];
+    if c.role_id.is_nil() {
+        errors.push("role_id_required".into());
+    }
+    if !["fa", "en"].contains(&c.language.as_str()) {
+        errors.push("invalid_language".into());
+    }
+    if c.model_ref.trim().is_empty() {
+        errors.push("model_required".into());
+    }
+    if c.guidance.chars().count() > 4000 {
+        errors.push("guidance_too_long".into());
+    }
+    if !(1..=3650).contains(&c.lookback_days) {
+        errors.push("invalid_lookback".into());
+    }
+    if c.sources.is_empty() || c.sources.len() > Source::ALL.len() {
+        errors.push("invalid_sources".into());
+    }
+    if c.metrics.len() > 50
+        || c.sections.len() > 20
+        || (c.metrics.is_empty() && c.sections.is_empty())
+    {
+        errors.push("invalid_output_count".into());
+    }
+    let mut sources = BTreeSet::new();
+    for selection in &c.sources {
+        if !sources.insert(selection.source) {
+            errors.push("duplicate_source".into());
+        }
+        match capabilities.iter().find(|s| s.source == selection.source) {
+            None => errors.push("unsupported_source".into()),
+            Some(cap) => {
+                if selection.allow_text && cap.text_categories.is_empty() {
+                    errors.push("text_not_supported".into());
+                }
+                if !cap.scopes.contains(&selection.scope) {
+                    errors.push("unsupported_scope".into());
+                }
+                if selection.categories.is_empty()
+                    || selection
+                        .categories
+                        .iter()
+                        .any(|cat| !cap.categories.contains(cat))
+                {
+                    errors.push("unsupported_category".into());
+                }
+                if !selection.allow_text
+                    && selection
+                        .categories
+                        .iter()
+                        .any(|cat| cap.text_categories.contains(cat))
+                {
+                    errors.push("text_not_allowed".into());
+                }
+                if (!selection.tools.is_empty()
+                    && !selection
+                        .tools
+                        .iter()
+                        .any(|tool| tool == "get_activity_overview"))
+                    || selection.tools.iter().any(|tool| !cap.tools.contains(tool))
+                {
+                    errors.push("unsupported_tool".into());
+                }
+            }
+        }
+    }
+    let mut keys = BTreeSet::new();
+    for m in &c.metrics {
+        if !valid_key(&m.key) || !keys.insert(m.key.clone()) {
+            errors.push("invalid_metric_key".into());
+        }
+        if !localized(&m.label) || !localized(&m.description) {
+            errors.push("metric_translations_required".into());
+        }
+        if m.value_type == MetricType::Enum
+            && (m.enum_values.is_empty()
+                || m.enum_values.len() > 30
+                || m.enum_values.iter().collect::<BTreeSet<_>>().len() != m.enum_values.len()
+                || m.enum_values
+                    .iter()
+                    .any(|v| v.trim().is_empty() || v.len() > 128))
+        {
+            errors.push("enum_values_required".into());
+        }
+        let bounds: Result<Vec<_>, _> = [&m.min, &m.max]
+            .into_iter()
+            .flatten()
+            .map(|v| v.parse::<rust_decimal::Decimal>())
+            .collect();
+        if bounds.is_err() || matches!(bounds, Ok(ref b) if b.len() == 2 && b[0] > b[1]) {
+            errors.push("invalid_metric_bounds".into());
+        }
+        if !matches!(m.value_type, MetricType::Number | MetricType::Integer)
+            && (m.min.is_some() || m.max.is_some())
+        {
+            errors.push("bounds_require_numeric_type".into());
+        }
+        if m.value_type == MetricType::Integer
+            && [&m.min, &m.max]
+                .into_iter()
+                .flatten()
+                .filter_map(|v| v.parse::<rust_decimal::Decimal>().ok())
+                .any(|v| v.fract() != rust_decimal::Decimal::ZERO)
+        {
+            errors.push("integer_bounds_required".into());
+        }
+        match &m.calculation {
+            Calculation::Aggregate { aggregate } => {
+                validate_aggregate(aggregate, c, capabilities, &mut errors)
+            }
+            Calculation::Formula { expression } => {
+                if !matches!(m.value_type, MetricType::Number | MetricType::Integer) {
+                    errors.push("formula_requires_numeric_type".into());
+                }
+                expression.validate(c, capabilities, &mut errors, 0);
+                if expression.unit(c, capabilities, 0).as_ref() != Ok(&m.unit) {
+                    errors.push("incompatible_formula_units".into());
+                }
+            }
+            Calculation::Assessment {
+                instructions,
+                rubric,
+                dependencies,
+            } => {
+                if instructions.trim().is_empty()
+                    || instructions.len() > 8000
+                    || rubric.is_empty()
+                    || dependencies.is_empty()
+                {
+                    errors.push("assessment_rubric_required".into());
+                }
+                let mut anchors = BTreeSet::new();
+                for anchor in rubric {
+                    let numeric = anchor
+                        .value
+                        .as_str()
+                        .map(str::to_owned)
+                        .or_else(|| anchor.value.as_number().map(ToString::to_string))
+                        .and_then(|v| v.parse::<rust_decimal::Decimal>().ok());
+                    let valid = match m.value_type {
+                        MetricType::Number | MetricType::Integer => numeric.is_some_and(|v| {
+                            (m.value_type != MetricType::Integer
+                                || v.fract() == rust_decimal::Decimal::ZERO)
+                                && !m
+                                    .min
+                                    .as_ref()
+                                    .and_then(|s| s.parse::<rust_decimal::Decimal>().ok())
+                                    .is_some_and(|min| v < min)
+                                && !m
+                                    .max
+                                    .as_ref()
+                                    .and_then(|s| s.parse::<rust_decimal::Decimal>().ok())
+                                    .is_some_and(|max| v > max)
+                        }),
+                        MetricType::Boolean => anchor.value.is_boolean(),
+                        MetricType::Enum => anchor
+                            .value
+                            .as_str()
+                            .is_some_and(|v| m.enum_values.iter().any(|s| s == v)),
+                    };
+                    if !valid
+                        || anchor.description.trim().is_empty()
+                        || anchor.description.len() > 4000
+                        || !anchors.insert(anchor.value.to_string())
+                    {
+                        errors.push("invalid_rubric_anchor".into());
+                    }
+                }
+                if dependencies.iter().any(|source| !sources.contains(source)) {
+                    errors.push("disabled_dependency".into());
+                }
+            }
+        }
+        if let Calculation::Aggregate { aggregate } = &m.calculation {
+            if let Some(cap) = capabilities
+                .iter()
+                .find(|s| s.source == aggregate.source)
+                .and_then(|s| {
+                    s.aggregates
+                        .iter()
+                        .find(|a| a.key == aggregate.key && a.category == aggregate.category)
+                })
+            {
+                if cap.value_type != m.value_type || cap.unit != m.unit {
+                    errors.push("aggregate_type_or_unit_mismatch".into());
+                }
+            }
+        }
+    }
+    for m in &c.metrics {
+        if let Calculation::Formula { expression } = &m.calculation {
+            let mut visited = BTreeSet::from([m.key.clone()]);
+            if expression.cyclic(c, &mut visited) {
+                errors.push("metric_dependency_cycle".into());
+            }
+        }
+    }
+    keys.clear();
+    for s in &c.sections {
+        if !valid_key(&s.key) || !keys.insert(s.key.clone()) {
+            errors.push("invalid_section_key".into());
+        }
+        if !localized(&s.title) {
+            errors.push("section_translations_required".into());
+        }
+        if s.instructions.trim().is_empty()
+            || s.instructions.len() > 8000
+            || !(1..=20000).contains(&s.max_chars)
+            || !(1..=100).contains(&s.max_items)
+        {
+            errors.push("invalid_section_limits".into());
+        }
+    }
+    if c.refresh.quiet_minutes == 0
+        || c.refresh.max_wait_minutes < c.refresh.quiet_minutes
+        || c.refresh.max_wait_minutes > 10080
+    {
+        errors.push("invalid_debounce".into());
+    }
+    if c.refresh.timezone.parse::<chrono_tz::Tz>().is_err()
+        || chrono::NaiveTime::parse_from_str(&c.refresh.daily_at, "%H:%M").is_err()
+    {
+        errors.push("invalid_schedule".into());
+    }
+    let b = &c.budgets;
+    if b.tool_calls < c.sources.len() as u32 * 2
+        || !(1..=100).contains(&b.tool_calls)
+        || !(1..=20).contains(&b.model_rounds)
+        || !(30..=900).contains(&b.timeout_seconds)
+        || !(1000..=128000).contains(&b.max_input_tokens)
+        || !(100..=16000).contains(&b.max_output_tokens)
+    {
+        errors.push("invalid_budgets".into());
+    }
+    if errors.is_empty() {
+        Ok(())
+    } else {
+        errors.sort();
+        errors.dedup();
+        Err(errors)
+    }
+}
+fn localized(value: &Localized) -> bool {
+    ["en", "fa"].iter().all(|locale| {
+        value
+            .get(*locale)
+            .is_some_and(|v| !v.trim().is_empty() && v.chars().count() <= 4000)
+    })
+}
+pub(crate) fn validate_aggregate(
+    a: &AggregateRef,
+    c: &SummaryConfiguration,
+    caps: &[SourceCapability],
+    errors: &mut Vec<String>,
+) {
+    if !c
+        .sources
+        .iter()
+        .any(|s| s.source == a.source && s.categories.contains(&a.category))
+    {
+        errors.push("disabled_dependency".into());
+    }
+    if !caps.iter().any(|s| {
+        s.source == a.source
+            && s.aggregates
+                .iter()
+                .any(|m| m.key == a.key && m.category == a.category)
+    }) {
+        errors.push("unknown_aggregate".into());
+    }
+}
