index 0000000..ad1b038
--- /dev/null
+++ b/shared/infera-summary-sdk/src/native_identity.rs
@@ -0,0 +1,190 @@
+//! Current native service identity, independent of the short-lived evidence grant.
+//! Credentials are source-owned and are never accepted from model arguments.
+use crate::Source;
+use uuid::Uuid;
+
+#[derive(Debug, Clone)]
+pub struct NativeIdentity {
+    pub user_id: Uuid,
+    pub roles: Vec<String>,
+    pub permissions: Vec<String>,
+}
+
+pub async fn validate(
+    source: Source,
+    expected_user: Uuid,
+    native_service: &str,
+    transport_permission: &str,
+) -> Result<NativeIdentity, String> {
+    let url = configured("IDP_VALIDATE_URL")?;
+    let token = configured(&format!(
+        "SUMMARY_{}_IDP_TOKEN",
+        source.key().to_uppercase()
+    ))?;
+    validate_at(
+        &url,
+        &token,
+        expected_user,
+        native_service,
+        transport_permission,
+    )
+    .await
+}
+
+async fn validate_at(
+    url: &str,
+    token: &str,
+    expected_user: Uuid,
+    native_service: &str,
+    transport_permission: &str,
+) -> Result<NativeIdentity, String> {
+    let response = reqwest::Client::builder()
+        .redirect(reqwest::redirect::Policy::none())
+        .timeout(std::time::Duration::from_secs(15))
+        .build()
+        .map_err(|_| "native_identity_unavailable")?
+        .get(url)
+        .bearer_auth(token)
+        .header("Accept", "application/json")
+        .header("X-Service", native_service)
+        .header("X-Permission-Scope", "service")
+        .header("X-Forwarded-Uri", "/mcp")
+        .header("X-Forwarded-Method", "POST")
+        .send()
+        .await
+        .map_err(|_| "native_identity_unavailable")?;
+    if matches!(response.status().as_u16(), 401 | 403) {
+        return Err("forbidden_native_identity".into());
+    }
+    if !response.status().is_success() {
+        return Err("native_identity_unavailable".into());
+    }
+    let headers = response.headers();
+    let user_id = headers
+        .get("x-user-id")
+        .and_then(|v| v.to_str().ok())
+        .and_then(|v| Uuid::parse_str(v).ok())
+        .filter(|id| !id.is_nil())
+        .ok_or("forbidden_native_identity")?;
+    if user_id != expected_user {
+        return Err("forbidden_native_identity_mismatch".into());
+    }
+    fn csv(headers: &reqwest::header::HeaderMap, key: &str) -> Result<Vec<String>, String> {
+        let text = headers
+            .get(key)
+            .map(|v| v.to_str())
+            .transpose()
+            .map_err(|_| "forbidden_native_identity")?
+            .unwrap_or("");
+        if text.len() > 65536 {
+            return Err("forbidden_native_identity".into());
+        }
+        Ok(text
+            .split(',')
+            .map(str::trim)
+            .filter(|s| !s.is_empty())
+            .map(str::to_owned)
+            .collect())
+    }
+    let permissions = csv(headers, "x-user-permissions")?;
+    if !permissions.iter().any(|p| p == transport_permission) {
+        return Err("forbidden_native_transport_permission".into());
+    }
+    Ok(NativeIdentity {
+        user_id,
+        roles: csv(headers, "x-user-roles")?,
+        permissions,
+    })
+}
+
+fn configured(key: &str) -> Result<String, String> {
+    std::env::var(key)
+        .ok()
+        .filter(|s| !s.trim().is_empty())
+        .ok_or_else(|| "native_identity_not_configured".into())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use axum::{
+        http::{HeaderMap, StatusCode},
+        routing::get,
+        Router,
+    };
+    use std::sync::{
+        atomic::{AtomicU8, Ordering},
+        Arc,
+    };
+    #[tokio::test]
+    async fn current_principal_is_rechecked_and_revocation_is_not_cached() {
+        let mode = Arc::new(AtomicU8::new(0));
+        let expected = Uuid::from_u128(5);
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let state = mode.clone();
+        let app = Router::new().route(
+            "/validate",
+            get(move |headers: HeaderMap| {
+                let mode = state.load(Ordering::SeqCst);
+                async move {
+                    assert_eq!(headers["x-service"], "lms");
+                    assert_eq!(headers["x-permission-scope"], "service");
+                    assert_eq!(headers["x-forwarded-uri"], "/mcp");
+                    assert_eq!(headers["x-forwarded-method"], "POST");
+                    assert_eq!(headers["authorization"], "Bearer test-only");
+                    let status = match mode {
+                        1 => StatusCode::UNAUTHORIZED,
+                        4 => StatusCode::SERVICE_UNAVAILABLE,
+                        _ => StatusCode::OK,
+                    };
+                    let id = if mode == 2 {
+                        Uuid::from_u128(6)
+                    } else {
+                        expected
+                    };
+                    let permission = if mode == 3 {
+                        "lms:classroom:read"
+                    } else {
+                        "lms:summary:read,lms:classroom:read"
+                    };
+                    (
+                        status,
+                        [
+                            ("x-user-id", id.to_string()),
+                            ("x-user-permissions", permission.to_owned()),
+                            ("x-user-roles", "support".to_owned()),
+                        ],
+                    )
+                }
+            }),
+        );
+        let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+        let url = format!("http://{addr}/validate");
+        let identity = validate_at(&url, "test-only", expected, "lms", "lms:summary:read")
+            .await
+            .unwrap();
+        assert_eq!(identity.roles, ["support"]);
+        for (value, error) in [
+            (1, "forbidden_native_identity"),
+            (2, "forbidden_native_identity_mismatch"),
+            (3, "forbidden_native_transport_permission"),
+            (4, "native_identity_unavailable"),
+        ] {
+            mode.store(value, Ordering::SeqCst);
+            assert_eq!(
+                validate_at(&url, "test-only", expected, "lms", "lms:summary:read")
+                    .await
+                    .unwrap_err(),
+                error
+            );
+        }
+        mode.store(0, Ordering::SeqCst);
+        assert!(
+            validate_at(&url, "test-only", expected, "lms", "lms:summary:read")
+                .await
+                .is_ok()
+        );
+        server.abort();
+    }
+}
diff --git a/shared/infera-summary-sdk/src/outbox.rs b/shared/infera-summary-sdk/src/outbox.rs
new file mode 100644
index 0000000..1a901d9
--- /dev/null
+++ b/shared/infera-summary-sdk/src/outbox.rs
@@ -0,0 +1,200 @@
+use crate::*;
+use lapin::{
+    options::*, types::FieldTable, BasicProperties, Connection, ConnectionProperties, ExchangeKind,
+};
+use sea_orm::{ConnectionTrait, DatabaseBackend, Statement};
+use serde_json::{json, Value};
+use uuid::Uuid;
+/// At-least-once delivery: DB leases are fenced; the consumer deduplicates event UUIDs.
+pub fn spawn<C: ConnectionTrait + Clone + Send + Sync + 'static>(db: C, source: Source) {
+    tokio::spawn(async move {
+        loop {
+            let broker = std::env::var("BROKER_URL");
+            let deployment =
+                std::env::var("SUMMARY_DEPLOYMENT_ID").or_else(|_| std::env::var("SANDBOX_ID"));
+            if let (Ok(broker), Ok(deployment)) = (broker, deployment) {
+                if publish(&db, source, &broker, &deployment).await.is_err() {
+                    tracing::warn!(source = source.key(), "summary activity outbox will retry");
+                }
+            }
+            tokio::time::sleep(std::time::Duration::from_secs(5)).await;
+        }
+    });
+}
+async fn publish<C: ConnectionTrait>(
+    db: &C,
+    source: Source,
+    broker: &str,
+    deployment: &str,
+) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
+    let pending=db.query_one(Statement::from_string(DatabaseBackend::Postgres,"SELECT 1 FROM summary_activity_outbox WHERE sent_at IS NULL AND (lease_until IS NULL OR lease_until<now()) LIMIT 1")).await?;
+    if pending.is_none() {
+        return Ok(());
+    }
+    let conn = Connection::connect(broker, ConnectionProperties::default()).await?;
+    let channel = conn.create_channel().await?;
+    let exchange =
+        std::env::var("RABBITMQ_EVENTS_EXCHANGE").unwrap_or_else(|_| "infera.events".into());
+    channel
+        .exchange_declare(
+            &exchange,
+            ExchangeKind::Topic,
+            ExchangeDeclareOptions {
+                durable: true,
+                ..Default::default()
+            },
+            FieldTable::default(),
+        )
+        .await?;
+    channel
+        .confirm_select(ConfirmSelectOptions::default())
+        .await?;
+    for _ in 0..100 {
+        let lease = Uuid::new_v4();
+        let row=db.query_one(Statement::from_sql_and_values(DatabaseBackend::Postgres,
+   "UPDATE summary_activity_outbox SET lease_token=$1,lease_until=now()+interval '1 minute',attempts=attempts+1 WHERE id=(SELECT id FROM summary_activity_outbox WHERE sent_at IS NULL AND (lease_until IS NULL OR lease_until<now()) ORDER BY occurred_at FOR UPDATE SKIP LOCKED LIMIT 1) RETURNING *",[lease.into()])).await?;
+        let Some(row) = row else {
+            break;
+        };
+        let id: Uuid = row.try_get("", "id")?;
+        let event = ActivityChanged {
+            event_id: id,
+            version: 1,
+            deployment_id: deployment.into(),
+            source,
+            relationship_change: row.try_get("", "relationship_change")?,
+            category: row.try_get("", "category")?,
+            subject_user_ids: serde_json::from_value(
+                row.try_get::<Value>("", "subject_user_ids")?,
+            )?,
+            previous_subject_user_ids: serde_json::from_value(
+                row.try_get::<Value>("", "previous_subject_user_ids")?,
+            )?,
+            revision: row.try_get("", "revision")?,
+            occurred_at: row.try_get("", "occurred_at")?,
+        };
+        let body = serde_json::to_vec(
+            &json!({"type":"profile.summary.activity.changed.v1","producer":source.key(),"version":1,"data":event}),
+        )?;
+        let confirmation = channel
+            .basic_publish(
+                &exchange,
+                "profile.summary.activity.changed.v1",
+                BasicPublishOptions {
+                    mandatory: true,
+                    ..Default::default()
+                },
+                &body,
+                BasicProperties::default()
+                    .with_delivery_mode(2)
+                    .with_message_id(id.to_string().into()),
+            )
+            .await?
+            .await?;
+        if !matches!(
+            confirmation,
+            lapin::publisher_confirm::Confirmation::Ack(None)
+        ) {
+            return Err("summary event routing was not acknowledged".into());
+        }
+        db.execute(Statement::from_sql_and_values(DatabaseBackend::Postgres,"UPDATE summary_activity_outbox SET sent_at=now(),lease_token=NULL,lease_until=NULL WHERE id=$1 AND lease_token=$2",[id.into(),lease.into()])).await?;
+    }
+    db.execute(Statement::from_string(DatabaseBackend::Postgres,"DELETE FROM summary_activity_outbox WHERE id IN (SELECT id FROM summary_activity_outbox WHERE sent_at<now()-interval '90 days' LIMIT 1000)")).await?;
+    conn.close(200, "summary outbox pass complete").await?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    #[ignore = "requires dedicated SUMMARY_TEST_DATABASE_URL and SUMMARY_TEST_BROKER_URL"]
+    async fn publishes_confirmed_events_and_marks_the_outbox_once() {
+        let database = std::env::var("SUMMARY_TEST_DATABASE_URL").unwrap();
+        assert!(database.contains("summary_test"));
+        let broker = std::env::var("SUMMARY_TEST_BROKER_URL").unwrap();
+        let admin = sea_orm::Database::connect(&database).await.unwrap();
+        let schema = format!("summary_test_{}", Uuid::new_v4().simple());
+        admin
+            .execute_unprepared(&format!("CREATE SCHEMA {schema}"))
+            .await
+            .unwrap();
+        let mut options = sea_orm::ConnectOptions::new(database);
+        options.set_schema_search_path(&schema);
+        let db = sea_orm::Database::connect(options).await.unwrap();
+        db.execute_unprepared(include_str!("outbox.sql"))
+            .await
+            .unwrap();
+        let conn = Connection::connect(&broker, ConnectionProperties::default())
+            .await
+            .unwrap();
+        let channel = conn.create_channel().await.unwrap();
+        let exchange = "infera.events";
+        channel
+            .exchange_declare(
+                exchange,
+                ExchangeKind::Topic,
+                ExchangeDeclareOptions {
+                    durable: true,
+                    ..Default::default()
+                },
+                FieldTable::default(),
+            )
+            .await
+            .unwrap();
+        let queue = channel
+            .queue_declare(
+                "",
+                QueueDeclareOptions {
+                    exclusive: true,
+                    auto_delete: true,
+                    ..Default::default()
+                },
+                FieldTable::default(),
+            )
+            .await
+            .unwrap();
+        channel
+            .queue_bind(
+                queue.name().as_str(),
+                exchange,
+                "profile.summary.activity.changed.v1",
+                QueueBindOptions::default(),
+                FieldTable::default(),
+            )
+            .await
+            .unwrap();
+        db.execute_unprepared("INSERT INTO summary_activity_outbox(source,category,subject_user_ids,previous_subject_user_ids,relationship_change,revision) VALUES('lms','attendance','[\"11111111-1111-4111-8111-111111111111\"]','[]',true,'fixture')").await.unwrap();
+        publish(&db, Source::Lms, &broker, "summary-transport-test")
+            .await
+            .unwrap();
+        let message = channel
+            .basic_get(queue.name().as_str(), BasicGetOptions::default())
+            .await
+            .unwrap()
+            .unwrap();
+        let payload: Value = serde_json::from_slice(&message.delivery.data).unwrap();
+        assert_eq!(payload["data"]["relationship_change"], true);
+        assert_eq!(payload["data"]["deployment_id"], "summary-transport-test");
+        message
+            .delivery
+            .ack(BasicAckOptions::default())
+            .await
+            .unwrap();
+        publish(&db, Source::Lms, &broker, "summary-transport-test")
+            .await
+            .unwrap();
+        assert!(channel
+            .basic_get(queue.name().as_str(), BasicGetOptions::default())
+            .await
+            .unwrap()
+            .is_none());
+        assert_eq!(db.query_one(Statement::from_string(DatabaseBackend::Postgres,"SELECT COUNT(*)::bigint AS count FROM summary_activity_outbox WHERE sent_at IS NOT NULL")).await.unwrap().unwrap().try_get::<i64>("","count").unwrap(),1);
+        conn.close(200, "test done").await.unwrap();
+        db.close().await.unwrap();
+        admin
+            .execute_unprepared(&format!("DROP SCHEMA {schema} CASCADE"))
+            .await
+            .unwrap();
+    }
+}
