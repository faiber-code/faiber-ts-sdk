+use crate::*;
+/// Versioned source contracts; source servers validate selections against these.
+pub fn source_capabilities() -> Vec<SourceCapability> {
+    Source::ALL
+        .into_iter()
+        .map(|source| {
+            let (categories, text, assigned): (&[&str], &[&str], bool) = match source {
+                Source::Lms => (
+                    &[
+                        "classrooms",
+                        "attendance",
+                        "homework",
+                        "exams",
+                        "evaluations",
+                    ],
+                    &["evaluations"],
+                    true,
+                ),
+                Source::Task => (&["work_items", "activity", "comments"], &["comments"], true),
+                Source::Crm => (&["leads", "tasks", "activities", "sos"], &[], true),
+                Source::Accounting => (
+                    &["enrollments", "installments", "transactions", "activity"],
+                    &[],
+                    true,
+                ),
+                Source::Session => (
+                    &["participation", "timing", "transcripts"],
+                    &["transcripts"],
+                    true,
+                ),
+                Source::Chat => (
+                    &["conversations", "activity", "response_timing", "messages"],
+                    &["messages"],
+                    false,
+                ),
+            };
+            let mut capability = SourceCapability {
+                source,
+                categories: categories.iter().map(|s| s.to_string()).collect(),
+                text_categories: text.iter().map(|s| s.to_string()).collect(),
+                scopes: if assigned {
+                    vec![Scope::Subject, Scope::Assigned]
+                } else {
+                    vec![Scope::Subject]
+                },
+                tools: vec![
+                    "get_subject_context".into(),
+                    "get_activity_overview".into(),
+                    "list_activity".into(),
+                    "get_activity_detail".into(),
+                ],
+                aggregates: categories
+                    .iter()
+                    .map(|category| AggregateCapability {
+                        key: "count".into(),
+                        category: category.to_string(),
+                        unit: "count".into(),
+                        value_type: MetricType::Integer,
+                    })
+                    .collect(),
+            };
+            if source == Source::Accounting {
+                for (category, key, unit, kind) in [
+                    ("installments", "amount_total", "IRR", MetricType::Number),
+                    (
+                        "installments",
+                        "overdue_amount_total",
+                        "IRR",
+                        MetricType::Number,
+                    ),
+                    (
+                        "installments",
+                        "overdue_count",
+                        "count",
+                        MetricType::Integer,
+                    ),
+                    ("transactions", "amount_total", "IRR", MetricType::Number),
+                    (
+                        "transactions",
+                        "accepted_amount_total",
+                        "IRR",
+                        MetricType::Number,
+                    ),
+                    (
+                        "transactions",
+                        "accepted_count",
+                        "count",
+                        MetricType::Integer,
+                    ),
+                ] {
+                    capability.aggregates.push(AggregateCapability {
+                        category: category.into(),
+                        key: key.into(),
+                        unit: unit.into(),
+                        value_type: kind,
+                    });
+                }
+            }
+            let extra: &[(&str, &str, &str, MetricType)] = match source {
+                Source::Lms => &[
+                    ("attendance", "present_count", "count", MetricType::Integer),
+                    (
+                        "attendance",
+                        "attended_seconds_total",
+                        "seconds",
+                        MetricType::Number,
+                    ),
+                    ("homework", "completed_count", "count", MetricType::Integer),
+                    ("homework", "score_average", "score", MetricType::Number),
+                    ("exams", "score_average", "score", MetricType::Number),
+                ],
+                Source::Task => &[
+                    (
+                        "work_items",
+                        "completed_count",
+                        "count",
+                        MetricType::Integer,
+                    ),
+                    ("work_items", "overdue_count", "count", MetricType::Integer),
+                ],
+                Source::Session => &[(
+                    "timing",
+                    "duration_seconds_total",
+                    "seconds",
+                    MetricType::Number,
+                )],
+                Source::Chat => &[(
+                    "response_timing",
+                    "response_seconds_average",
+                    "seconds",
+                    MetricType::Number,
+                )],
+                Source::Crm => &[
+                    ("tasks", "completed_count", "count", MetricType::Integer),
+                    ("tasks", "overdue_count", "count", MetricType::Integer),
+                    ("activities", "call_count", "count", MetricType::Integer),
+                    ("activities", "meeting_count", "count", MetricType::Integer),
+                    ("activities", "message_count", "count", MetricType::Integer),
+                    (
+                        "activities",
+                        "duration_seconds_total",
+                        "seconds",
+                        MetricType::Number,
+                    ),
+                ],
+                _ => &[],
+            };
+            for (category, key, unit, kind) in extra {
+                capability.aggregates.push(AggregateCapability {
+                    category: (*category).into(),
+                    key: (*key).into(),
+                    unit: (*unit).into(),
+                    value_type: *kind,
+                });
+            }
+            capability
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn config() -> SummaryConfiguration {
+        SummaryConfiguration {
+            role_id: uuid::Uuid::new_v4(),
+            model_ref: "model".into(),
+            sources: vec![SourceSelection {
+                source: Source::Task,
+                required: true,
+                scope: Scope::Subject,
+                categories: vec!["work_items".into()],
+                tools: vec![],
+                allow_text: false,
+            }],
+            metrics: vec![MetricDefinition {
+                key: "done".into(),
+                label: [("en".into(), "Count".into()), ("fa".into(), "تعداد".into())].into(),
+                description: [
+                    ("en".into(), "Work count".into()),
+                    ("fa".into(), "تعداد کار".into()),
+                ]
+                .into(),
+                value_type: MetricType::Integer,
+                unit: "count".into(),
+                min: None,
+                max: None,
+                enum_values: vec![],
+                calculation: Calculation::Aggregate {
+                    aggregate: AggregateRef {
+                        source: Source::Task,
+                        category: "work_items".into(),
+                        key: "count".into(),
+                    },
+                },
+            }],
+            ..Default::default()
+        }
+    }
+    #[test]
+    fn accepts_arbitrary_role_and_rejects_disabled_source() {
+        let mut c = config();
+        assert!(validate_configuration(&c, &source_capabilities()).is_ok());
+        c.sources.clear();
+        assert!(validate_configuration(&c, &source_capabilities()).is_err());
+    }
+    #[test]
+    fn crm_capabilities_and_six_source_configurations_use_the_same_contract() {
+        let caps = source_capabilities();
+        assert_eq!(caps.len(), 6);
+        let crm = caps.iter().find(|c| c.source == Source::Crm).unwrap();
+        assert!(crm.text_categories.is_empty());
+        assert!(crm
+            .aggregates
+            .iter()
+            .any(|a| a.category == "tasks" && a.key == "completed_count"));
+        let mut c = config();
+        c.sources = caps
+            .iter()
+            .map(|cap| SourceSelection {
+                source: cap.source,
+                required: true,
+                scope: Scope::Subject,
+                allow_text: false,
+                categories: cap
+                    .categories
+                    .iter()
+                    .filter(|s| !cap.text_categories.contains(s))
+                    .cloned()
+                    .collect(),
+                tools: vec![],
+            })
+            .collect();
+        assert_eq!(validate_configuration(&c, &caps), Ok(()));
+        assert_eq!(serde_json::to_string(&Source::Crm).unwrap(), "\"crm\"");
+        c.sources
+            .iter_mut()
+            .find(|s| s.source == Source::Crm)
+            .unwrap()
+            .allow_text = true;
+        assert!(validate_configuration(&c, &caps)
+            .unwrap_err()
+            .contains(&"text_not_supported".into()));
+    }
+    #[test]
+    fn rejects_cycles_and_text_without_opt_in() {
+        let mut c = config();
+        c.metrics[0].calculation = Calculation::Formula {
+            expression: Formula::Metric { key: "done".into() },
+        };
+        assert!(validate_configuration(&c, &source_capabilities())
+            .unwrap_err()
+            .contains(&"metric_dependency_cycle".into()));
+        c = config();
+        c.sources[0].categories.push("comments".into());
+        assert!(validate_configuration(&c, &source_capabilities())
+            .unwrap_err()
+            .contains(&"text_not_allowed".into()));
+    }
+}
