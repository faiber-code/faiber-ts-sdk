+//! Shared, versioned contracts. Domain authorization remains in each source service.
+pub mod api;
+pub mod catalog;
+pub mod config;
+pub mod evidence;
+pub mod grant;
+pub mod metric;
+#[cfg(feature = "server")]
+pub mod native_identity;
+#[cfg(feature = "server")]
+pub mod outbox;
+#[cfg(feature = "server")]
+pub mod query;
+pub mod result;
+#[cfg(feature = "server")]
+pub mod server;
+pub use catalog::*;
+pub use config::*;
+pub use evidence::*;
+pub use grant::*;
+pub use metric::*;
+pub use result::*;
+
+pub fn fingerprint<T: serde::Serialize>(value: &T) -> String {
+    use sha2::{Digest, Sha256};
+    fn canonical(value: serde_json::Value) -> serde_json::Value {
+        match value {
+            serde_json::Value::Object(map) => {
+                let sorted: std::collections::BTreeMap<_, _> = map
+                    .into_iter()
+                    .map(|(key, value)| (key, canonical(value)))
+                    .collect();
+                serde_json::to_value(sorted).expect("serializable JSON")
+            }
+            serde_json::Value::Array(items) => items.into_iter().map(canonical).collect(),
+            other => other,
+        }
+    }
+    hex::encode(Sha256::digest(
+        serde_json::to_vec(&canonical(
+            serde_json::to_value(value).expect("summary contracts serialize"),
+        ))
+        .expect("JSON serializes"),
+    ))
+}
+
+#[cfg(feature = "server")]
+pub use rmcp;
diff --git a/shared/infera-summary-sdk/src/metric.rs b/shared/infera-summary-sdk/src/metric.rs
new file mode 100644
index 0000000..507d16f
--- /dev/null
+++ b/shared/infera-summary-sdk/src/metric.rs
@@ -0,0 +1,259 @@
+use crate::{AggregateRef, Calculation, SourceCapability, SummaryConfiguration};
+use rust_decimal::Decimal;
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(schemars::JsonSchema, Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum MetricType {
+    Number,
+    Integer,
+    Boolean,
+    Enum,
+}
+
+/// A bounded AST; never evaluated as SQL, JavaScript, or another programming language.
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "op", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Formula {
+    Constant {
+        value: String,
+    },
+    Aggregate {
+        aggregate: AggregateRef,
+    },
+    Metric {
+        key: String,
+    },
+    Add {
+        left: Box<Formula>,
+        right: Box<Formula>,
+    },
+    Subtract {
+        left: Box<Formula>,
+        right: Box<Formula>,
+    },
+    Multiply {
+        left: Box<Formula>,
+        right: Box<Formula>,
+    },
+    Divide {
+        left: Box<Formula>,
+        right: Box<Formula>,
+    },
+    Percentage {
+        numerator: Box<Formula>,
+        denominator: Box<Formula>,
+    },
+    Round {
+        value: Box<Formula>,
+        places: u32,
+    },
+}
+impl Formula {
+    fn children(&self) -> Vec<&Formula> {
+        match self {
+            Self::Add { left, right }
+            | Self::Subtract { left, right }
+            | Self::Multiply { left, right }
+            | Self::Divide { left, right } => vec![left, right],
+            Self::Percentage {
+                numerator,
+                denominator,
+            } => vec![numerator, denominator],
+            Self::Round { value, .. } => vec![value],
+            _ => vec![],
+        }
+    }
+    pub(crate) fn validate(
+        &self,
+        c: &SummaryConfiguration,
+        caps: &[SourceCapability],
+        errors: &mut Vec<String>,
+        depth: usize,
+    ) {
+        if depth > 12 {
+            errors.push("formula_too_deep".into());
+            return;
+        }
+        match self {
+            Self::Constant { value } if value.parse::<Decimal>().is_err() => {
+                errors.push("invalid_constant".into())
+            }
+            Self::Aggregate { aggregate } => {
+                crate::config::validate_aggregate(aggregate, c, caps, errors)
+            }
+            Self::Metric { key } => match c.metrics.iter().find(|m| &m.key == key) {
+                Some(m)
+                    if matches!(m.value_type, MetricType::Number | MetricType::Integer)
+                        && !matches!(m.calculation, Calculation::Assessment { .. }) =>
+                {
+                    ()
+                }
+                _ => errors.push("invalid_metric_dependency".into()),
+            },
+            Self::Round { places, .. } if *places > 8 => errors.push("invalid_rounding".into()),
+            _ => (),
+        }
+        for child in self.children() {
+            child.validate(c, caps, errors, depth + 1);
+        }
+    }
+    pub(crate) fn cyclic(&self, c: &SummaryConfiguration, visited: &mut BTreeSet<String>) -> bool {
+        if let Self::Metric { key } = self {
+            if !visited.insert(key.clone()) {
+                return true;
+            }
+            let cycle=c.metrics.iter().find(|m| &m.key==key).is_some_and(|m| matches!(&m.calculation,Calculation::Formula{expression} if expression.cyclic(c,visited)));
+            visited.remove(key);
+            return cycle;
+        }
+        self.children()
+            .into_iter()
+            .any(|child| child.cyclic(c, visited))
+    }
+    pub fn unit(
+        &self,
+        c: &SummaryConfiguration,
+        caps: &[SourceCapability],
+        depth: usize,
+    ) -> Result<String, ()> {
+        if depth > 12 {
+            return Err(());
+        }
+        let unit = |f: &Formula| f.unit(c, caps, depth + 1);
+        match self {
+            Self::Constant { .. } => Ok(String::new()),
+            Self::Aggregate { aggregate } => caps
+                .iter()
+                .find(|s| s.source == aggregate.source)
+                .and_then(|s| {
+                    s.aggregates
+                        .iter()
+                        .find(|a| a.category == aggregate.category && a.key == aggregate.key)
+                })
+                .map(|a| a.unit.clone())
+                .ok_or(()),
+            Self::Metric { key } => c
+                .metrics
+                .iter()
+                .find(|m| &m.key == key)
+                .map(|m| m.unit.clone())
+                .ok_or(()),
+            Self::Add { left, right } | Self::Subtract { left, right } => {
+                let a = unit(left)?;
+                if a == unit(right)? {
+                    Ok(a)
+                } else {
+                    Err(())
+                }
+            }
+            Self::Multiply { left, right } => {
+                let a = unit(left)?;
+                let b = unit(right)?;
+                if a.is_empty() {
+                    Ok(b)
+                } else if b.is_empty() {
+                    Ok(a)
+                } else {
+                    Err(())
+                }
+            }
+            Self::Divide { left, right } => {
+                let a = unit(left)?;
+                let b = unit(right)?;
+                if a == b {
+                    Ok(String::new())
+                } else if b.is_empty() {
+                    Ok(a)
+                } else {
+                    Err(())
+                }
+            }
+            Self::Percentage {
+                numerator,
+                denominator,
+            } => {
+                if unit(numerator)? == unit(denominator)? {
+                    Ok("percent".into())
+                } else {
+                    Err(())
+                }
+            }
+            Self::Round { value, .. } => unit(value),
+        }
+    }
+    pub fn evaluate(
+        &self,
+        c: &SummaryConfiguration,
+        aggregates: &BTreeMap<String, Decimal>,
+        depth: usize,
+    ) -> Option<Decimal> {
+        if depth > 20 {
+            return None;
+        }
+        let eval = |f: &Formula| f.evaluate(c, aggregates, depth + 1);
+        match self {
+            Self::Constant { value } => value.parse().ok(),
+            Self::Aggregate { aggregate } => aggregates.get(&aggregate_key(aggregate)).copied(),
+            Self::Metric { key } => c
+                .metrics
+                .iter()
+                .find(|m| &m.key == key)
+                .and_then(|m| match &m.calculation {
+                    Calculation::Aggregate { aggregate } => {
+                        aggregates.get(&aggregate_key(aggregate)).copied()
+                    }
+                    Calculation::Formula { expression } => eval(expression),
+                    _ => None,
+                }),
+            Self::Add { left, right } => eval(left)?.checked_add(eval(right)?),
+            Self::Subtract { left, right } => eval(left)?.checked_sub(eval(right)?),
+            Self::Multiply { left, right } => eval(left)?.checked_mul(eval(right)?),
+            Self::Divide { left, right } => eval(left)?.checked_div(eval(right)?),
+            Self::Percentage {
+                numerator,
+                denominator,
+            } => eval(numerator)?
+                .checked_div(eval(denominator)?)?
+                .checked_mul(Decimal::from(100)),
+            Self::Round { value, places } => Some(eval(value)?.round_dp(*places)),
+        }
+    }
+}
+pub fn aggregate_key(a: &AggregateRef) -> String {
+    format!("{}.{}.{}", a.source.key(), a.category, a.key)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn division_by_zero_is_unavailable() {
+        let f = Formula::Divide {
+            left: Box::new(Formula::Constant { value: "1".into() }),
+            right: Box::new(Formula::Constant { value: "0".into() }),
+        };
+        assert_eq!(
+            f.evaluate(&SummaryConfiguration::default(), &BTreeMap::new(), 0),
+            None
+        );
+    }
+    #[test]
+    fn financial_decimal_is_exact() {
+        let f = Formula::Add {
+            left: Box::new(Formula::Constant {
+                value: "0.1".into(),
+            }),
+            right: Box::new(Formula::Constant {
+                value: "0.2".into(),
+            }),
+        };
+        assert_eq!(
+            f.evaluate(&SummaryConfiguration::default(), &BTreeMap::new(), 0)
+                .unwrap()
+                .to_string(),
+            "0.3"
+        );
+    }
+}
