new file mode 100644
index 0000000..5cc7f0f
--- /dev/null
+++ b/src/summary_evidence.sql
@@ -0,0 +1,18 @@
+WITH conversations AS (
+ SELECT c.*, EXISTS(SELECT 1 FROM chat_conversation_members m WHERE m.conversation_id=c.id AND m.user_id=$2 AND m.left_at IS NULL AND m.state='active') AS principal_authorized FROM chat_conversations c WHERE c.organization_id=$3 AND c.deleted_at IS NULL AND c.status='active'
+ AND EXISTS(SELECT 1 FROM chat_conversation_members m WHERE m.conversation_id=c.id AND m.user_id=$1 AND m.left_at IS NULL AND m.state='active')
+
+), sequenced AS (
+ SELECT m.*,c.principal_authorized,LAG(m.sender_id) OVER(PARTITION BY m.conversation_id ORDER BY m.sequence,m.id) AS previous_sender,LAG(m.created_at) OVER(PARTITION BY m.conversation_id ORDER BY m.sequence,m.id) AS previous_at FROM chat_messages m JOIN conversations c ON c.id=m.conversation_id WHERE m.deleted_at IS NULL
+), rows AS (
+ SELECT c.id::text id,'conversations'::text category,c.updated_at::text version,c.updated_at occurred_at,c.principal_authorized,jsonb_build_object('kind',c.kind,'status',c.status,'last_message_at',c.last_message_at) data FROM conversations c
+ UNION ALL
+ SELECT m.id::text,'activity',COALESCE(m.edited_at,m.created_at)::text,m.created_at,c.principal_authorized,jsonb_build_object('conversation_id',m.conversation_id,'sender_id',m.sender_id,'message_type',m.message_type)
+ FROM chat_messages m JOIN conversations c ON c.id=m.conversation_id WHERE m.deleted_at IS NULL AND m.sender_id=$1
+ UNION ALL
+ SELECT m.id::text,'response_timing',COALESCE(m.edited_at,m.created_at)::text,m.created_at,m.principal_authorized,jsonb_build_object('conversation_id',m.conversation_id,'sender_id',m.sender_id,'response_seconds',GREATEST(0,EXTRACT(EPOCH FROM m.created_at-m.previous_at))::text)
+ FROM sequenced m WHERE m.sender_id=$1 AND m.previous_sender<>$1 AND m.previous_at>=$5
+ UNION ALL
+ SELECT m.id::text,'messages',COALESCE(m.edited_at,m.created_at)::text,m.created_at,c.principal_authorized,jsonb_build_object('conversation_id',m.conversation_id,'sender_id',m.sender_id,'content',substring(m.content::text FROM (/*SUMMARY_TEXT_OFFSET*/0+1) FOR 4000),'text_total_chars',char_length(m.content::text),'text_offset',/*SUMMARY_TEXT_OFFSET*/0,'text_next_offset',CASE WHEN char_length(m.content::text)>/*SUMMARY_TEXT_OFFSET*/0+4000 THEN /*SUMMARY_TEXT_OFFSET*/0+4000 ELSE NULL END)
+ FROM chat_messages m JOIN conversations c ON c.id=m.conversation_id WHERE m.deleted_at IS NULL AND $8
+) SELECT * FROM rows
diff --git a/src/summary_query.rs b/src/summary_query.rs
new file mode 100644
index 0000000..23bc961
--- /dev/null
+++ b/src/summary_query.rs
@@ -0,0 +1,58 @@
+//! Source-owned native policy and domain queries; no application-state dependencies.
+use infera_summary_sdk::{server::EvidenceReader, *};
+use sea_orm::{ConnectionTrait, DatabaseBackend, DatabaseConnection, Statement, TransactionTrait};
+#[derive(Clone)]
+pub struct Reader(pub DatabaseConnection);
+impl EvidenceReader for Reader {
+    fn source(&self) -> Source {
+        Source::Chat
+    }
+    async fn read(
+        &self,
+        g: EvidenceGrant,
+        tool: String,
+        args: ActivityArguments,
+    ) -> Result<EvidenceEnvelope, String> {
+        if g.native_scope_id.is_none() {
+            return Err("native_scope_required".into());
+        }
+        let identity =
+            native_identity::validate(Source::Chat, g.service_user_id, "chat", "chat:summary:read")
+                .await?;
+        if !identity
+            .permissions
+            .iter()
+            .any(|p| ["chat:read", "chat:chat:read", "chat:*", "*"].contains(&p.as_str()))
+        {
+            return Err("forbidden_chat_native_permission".into());
+        }
+        if g.scope != Scope::Subject {
+            return Err("unsupported_relationship_scope".into());
+        }
+        let tx = self
+            .0
+            .begin()
+            .await
+            .map_err(|_| "native_coverage_check_unavailable")?;
+        tx.execute(Statement::from_string(
+            DatabaseBackend::Postgres,
+            "SET TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY",
+        ))
+        .await
+        .map_err(|_| "native_coverage_check_unavailable")?;
+        let sql = include_str!("summary_evidence.sql");
+        query::ensure_native_coverage(&tx, &g, &args, sql).await?;
+        let authorized = format!("SELECT * FROM ({sql}) native_rows WHERE principal_authorized");
+        let result = query::evidence_with_aggregates(
+            &tx,
+            &g,
+            &tool,
+            args,
+            &authorized,
+            include_str!("summary_aggregates.sql"),
+        )
+        .await?;
+        tx.commit().await.map_err(|_| "evidence_query_failed")?;
+        Ok(result)
+    }
+}
