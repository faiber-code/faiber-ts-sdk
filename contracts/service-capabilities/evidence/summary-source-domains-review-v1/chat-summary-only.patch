+    ///
+    /// This function will call [`Peer<RoleClient>::list_prompts`] multiple times until all prompts are listed.
+    pub async fn list_all_prompts(&self) -> Result<Vec<crate::model::Prompt>, ServiceError> {
+        let mut prompts = Vec::new();
