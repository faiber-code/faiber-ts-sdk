@@ -0,0 +1,126 @@
+use crate::{Scope, Source};
+use base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine};
+use ed25519_dalek::{Signature, Signer, SigningKey, Verifier, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use uuid::Uuid;
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct EvidenceGrant {
+    pub iss: String,
+    pub aud: Source,
+    pub deployment_id: String,
+    pub service_user_id: Uuid,
+    pub subject_user_id: Uuid,
+    pub role_id: Uuid,
+    pub run_id: Uuid,
+    pub config_revision: i64,
+    pub tools: Vec<String>,
+    pub categories: Vec<String>,
+    pub scope: Scope,
+    pub allow_text: bool,
+    pub window_start: chrono::DateTime<chrono::Utc>,
+    pub cutoff: chrono::DateTime<chrono::Utc>,
+    pub native_scope_id: Option<Uuid>,
+    pub iat: i64,
+    pub exp: i64,
+}
+#[derive(Debug, thiserror::Error)]
+#[error("invalid summary evidence grant")]
+pub struct GrantError;
+pub fn sign_grant(grant: &EvidenceGrant, private_key: &str) -> Result<String, GrantError> {
+    let bytes = URL_SAFE_NO_PAD
+        .decode(private_key)
+        .map_err(|_| GrantError)?;
+    let key = SigningKey::from_bytes(&bytes.try_into().map_err(|_| GrantError)?);
+    let body = URL_SAFE_NO_PAD.encode(serde_json::to_vec(grant).map_err(|_| GrantError)?);
+    let signature = key.sign(body.as_bytes());
+    Ok(format!(
+        "{body}.{}",
+        URL_SAFE_NO_PAD.encode(signature.to_bytes())
+    ))
+}
+pub fn verify_grant(
+    token: &str,
+    public_key: &str,
+    source: Source,
+    deployment: &str,
+    now: i64,
+) -> Result<EvidenceGrant, GrantError> {
+    if token.len() > 16384 {
+        return Err(GrantError);
+    }
+    let (body, signature) = token.split_once('.').ok_or(GrantError)?;
+    let key = URL_SAFE_NO_PAD.decode(public_key).map_err(|_| GrantError)?;
+    let key = VerifyingKey::from_bytes(&key.try_into().map_err(|_| GrantError)?)
+        .map_err(|_| GrantError)?;
+    let signature =
+        Signature::from_slice(&URL_SAFE_NO_PAD.decode(signature).map_err(|_| GrantError)?)
+            .map_err(|_| GrantError)?;
+    key.verify(body.as_bytes(), &signature)
+        .map_err(|_| GrantError)?;
+    let grant: EvidenceGrant =
+        serde_json::from_slice(&URL_SAFE_NO_PAD.decode(body).map_err(|_| GrantError)?)
+            .map_err(|_| GrantError)?;
+    if grant.iss != "infera-profile"
+        || grant.aud != source
+        || grant.deployment_id != deployment
+        || grant.exp <= now
+        || grant.iat > now + 30
+        || grant.exp - grant.iat > 1200
+        || grant.window_start > grant.cutoff
+        || grant.cutoff.timestamp() > now + 30
+        || grant.config_revision < 1
+        || grant.role_id.is_nil()
+        || grant.run_id.is_nil()
+        || grant.subject_user_id.is_nil()
+        || grant.service_user_id.is_nil()
+    {
+        return Err(GrantError);
+    }
+    Ok(grant)
+}
+impl EvidenceGrant {
+    pub fn allows(&self, tool: &str, category: Option<&str>, text: bool) -> bool {
+        self.tools.iter().any(|v| v == tool)
+            && category.is_none_or(|cat| self.categories.iter().any(|v| v == cat))
+            && (!text || self.allow_text)
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn binds_source_deployment_expiration_and_signature() {
+        let key = SigningKey::from_bytes(&[7; 32]);
+        let now = chrono::Utc::now();
+        let g = EvidenceGrant {
+            iss: "infera-profile".into(),
+            aud: Source::Lms,
+            deployment_id: "one".into(),
+            service_user_id: Uuid::new_v4(),
+            subject_user_id: Uuid::new_v4(),
+            role_id: Uuid::new_v4(),
+            run_id: Uuid::new_v4(),
+            config_revision: 1,
+            tools: vec![],
+            categories: vec![],
+            scope: Scope::Subject,
+            allow_text: false,
+            window_start: now,
+            cutoff: now,
+            native_scope_id: None,
+            iat: now.timestamp(),
+            exp: now.timestamp() + 60,
+        };
+        let token = sign_grant(&g, &URL_SAFE_NO_PAD.encode(key.to_bytes())).unwrap();
+        let public = URL_SAFE_NO_PAD.encode(key.verifying_key().to_bytes());
+        assert!(verify_grant(&token, &public, Source::Lms, "one", now.timestamp()).is_ok());
+        assert!(verify_grant(&token, &public, Source::Chat, "one", now.timestamp()).is_err());
+        assert!(verify_grant(&token, &public, Source::Lms, "two", now.timestamp()).is_err());
+        assert!(verify_grant(&token, &public, Source::Lms, "one", now.timestamp() + 61).is_err());
+        assert!(
+            verify_grant(&(token + "x"), &public, Source::Lms, "one", now.timestamp()).is_err()
+        );
+    }
+}
