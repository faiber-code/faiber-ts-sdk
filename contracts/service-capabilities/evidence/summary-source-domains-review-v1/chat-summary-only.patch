+pub struct ConfigurationStatus {
+    pub id: Uuid,
+    pub enabled: bool,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct RoleOption {
+    pub id: Uuid,
+    pub name: String,
+    pub configuration: Option<ConfigurationStatus>,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct ModelOption {
+    pub model_ref: String,
+    pub model: String,
+    pub provider_label: String,
+    pub supports_tools: bool,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct ToolSchema {
+    #[serde(rename = "inputSchema")]
+    pub input_schema: serde_json::Value,
+    #[serde(rename = "outputSchema")]
+    pub output_schema: serde_json::Value,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct SourceOption {
+    #[serde(flatten)]
+    pub capability: SourceCapability,
+    pub configured: bool,
+    pub tool_schemas: std::collections::BTreeMap<String, ToolSchema>,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Default, Serialize, Deserialize)]
+pub struct ListQuery {
+    pub user_id: Option<Uuid>,
+    pub role_id: Option<Uuid>,
+    pub status: Option<String>,
+    pub page: Option<i64>,
+    pub per_page: Option<i64>,
+}
+
+/// OpenAPI-compatible component schemas generated from the public Rust wire types.
+pub fn schemas() -> serde_json::Map<String, serde_json::Value> {
+    let mut output = serde_json::Map::new();
+    macro_rules! add {
+        ($name:literal,$ty:ty) => {{
+            let raw = serde_json::to_value(schemars::schema_for!($ty)).expect("schema serializes");
+            let mut schema: serde_json::Value =
+                serde_json::from_str(&raw.to_string().replace("#/$defs/", "#/components/schemas/"))
+                    .expect("valid schema");
+            if let Some(definitions) = schema
+                .get_mut("$defs")
+                .and_then(serde_json::Value::as_object_mut)
+            {
+                for (key, value) in std::mem::take(definitions) {
+                    output.insert(key, value);
+                }
+            }
+            schema.as_object_mut().unwrap().remove("$defs");
+            schema.as_object_mut().unwrap().remove("$schema");
+            output.insert($name.into(), schema);
+        }};
+    }
+    add!("EvidenceEnvelope", EvidenceEnvelope);
+    add!("SummarySettings", Settings);
+    add!("SummaryConfigurationWrite", ConfigurationWrite);
+    add!("SummarySettingsResponse", Envelope<Settings>);
+    add!(
+        "SummaryConfigurationResponse",
+        Envelope<ConfigurationRecord>
+    );
+    add!(
+        "SummaryConfigurationsResponse",
+        Envelope<Vec<ConfigurationRecord>>
+    );
+    add!("SummaryRolesResponse", Envelope<Vec<RoleOption>>);
+    add!("SummaryModelsResponse", Envelope<Vec<ModelOption>>);
+    add!("SummarySourcesResponse", Envelope<Vec<SourceOption>>);
+    add!("SummarySourceCheckResponse", Envelope<SourceCheck>);
+    add!("SummaryValidationResponse", Envelope<Validation>);
+    add!("SummaryPreviewRequest", PreviewRequest);
+    add!("SummaryPreviewResponse", Envelope<PreviewResponse>);
+    add!("SummaryStatusRequest", StatusRequest);
+    add!("SummaryLatestResponse", Envelope<Latest>);
+    add!("SummaryRunResponse", Envelope<RunRecord>);
+    add!("SummaryRunsResponse", Envelope<Page<RunRecord>>);
+    add!("SummaryJobsResponse", Envelope<Page<JobRecord>>);
+    add!("SummaryRefreshRequest", RefreshRequest);
+    add!("SummaryRefreshResponse", Envelope<RefreshResponse>);
+    add!("SummaryRetryResponse", Envelope<QueuedJob>);
+    output
+}
+
+pub fn evidence_schema() -> serde_json::Value {
+    serde_json::to_value(schemars::schema_for!(EvidenceEnvelope)).expect("evidence schema")
+}
