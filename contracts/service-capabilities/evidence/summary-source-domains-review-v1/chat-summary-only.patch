+//! Public Profile REST contracts. Execution grants and private job leases never appear here.
+use crate::*;
+use serde::{Deserialize, Serialize};
+use uuid::Uuid;
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct Settings {
+    pub globally_enabled: bool,
+    pub concurrency_limit: i32,
+    pub retention_days: i32,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct ConfigurationWrite {
+    pub configuration: SummaryConfiguration,
+    pub expected_version: Option<i64>,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct ConfigurationRecord {
+    pub id: Uuid,
+    pub deployment_id: String,
+    pub role_id: Uuid,
+    pub enabled: bool,
+    pub draft: SummaryConfiguration,
+    pub draft_version: i64,
+    pub published_revision: Option<i64>,
+    pub published_by: Option<Uuid>,
+    pub published_at: Option<chrono::DateTime<chrono::Utc>>,
+    pub created_at: chrono::DateTime<chrono::Utc>,
+    pub updated_at: chrono::DateTime<chrono::Utc>,
+}
+#[derive(schemars::JsonSchema, Debug, Clone, Serialize, Deserialize)]
+pub struct RunRecord {
+    pub id: Uuid,
+    pub subject_user_id: Uuid,
+    pub role_id: Uuid,
+    pub config_revision: i64,
+    pub configuration: SummaryConfiguration,
+    pub preview: bool,
+    pub status: String,
+    pub window_start: chrono::DateTime<chrono::Utc>,
+    pub cutoff: chrono::DateTime<chrono::Utc>,
