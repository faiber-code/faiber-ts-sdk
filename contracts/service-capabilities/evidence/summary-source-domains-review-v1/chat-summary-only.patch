@@ -0,0 +1,322 @@
+#[path = "../../../src/summary_query.rs"]
+mod production;
+#[cfg(test)]
+mod tests {
+    use super::production::Reader;
+    use base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine};
+    use ed25519_dalek::SigningKey;
+    use infera_summary_sdk::{
+        rmcp::{
+            model::CallToolRequestParam,
+            transport::{
+                streamable_http_client::StreamableHttpClientTransportConfig,
+                StreamableHttpClientTransport,
+            },
+            ServiceExt,
+        },
+        server::EvidenceReader,
+        *,
+    };
+    use migration::{Migrator, MigratorTrait};
+    use sea_orm::{ConnectionTrait, Database, DbBackend, Statement};
+    use serde_json::{json, Value};
+    use std::sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    };
+    use uuid::Uuid;
+    fn args(v: Value) -> ActivityArguments {
+        serde_json::from_value(v).unwrap()
+    }
+    #[tokio::test]
+    async fn actual_migrations_sql_mcp_and_current_native_access() {
+        let db = Database::connect(
+            std::env::var("SUMMARY_TEST_DATABASE_URL").expect("disposable PostgreSQL required"),
+        )
+        .await
+        .unwrap();
+        Migrator::up(&db, None).await.unwrap();
+        db.execute_unprepared(include_str!("../fixture.sql"))
+            .await
+            .unwrap();
+        let state = Arc::new(AtomicUsize::new(0));
+        let checks = Arc::new(AtomicUsize::new(0));
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        std::env::set_var(
+            "IDP_VALIDATE_URL",
+            format!("http://{}/validate", listener.local_addr().unwrap()),
+        );
+        std::env::set_var("SUMMARY_CHAT_IDP_TOKEN", "fixture-only-token");
+        let identity_state = state.clone();
+        let identity_checks = checks.clone();
+        let identity_task = tokio::spawn(async move {
+            axum::serve(
+                listener,
+                axum::Router::new().route(
+                    "/validate",
+                    axum::routing::get(move |h: axum::http::HeaderMap| {
+                        let state = identity_state.clone();
+                        let checks = identity_checks.clone();
+                        async move {
+                            assert_eq!(h["authorization"], "Bearer fixture-only-token");
+                            assert_eq!(h["x-service"], "chat");
+                            assert_eq!(h["x-forwarded-uri"], "/mcp");
+                            assert_eq!(h["x-permission-scope"], "service");
+                            checks.fetch_add(1, Ordering::SeqCst);
+                            let n = state.load(Ordering::SeqCst);
+                            let mut h = axum::http::HeaderMap::new();
+                            h.insert(
+                                "x-user-id",
+                                Uuid::from_u128(if n == 2 { 999 } else { 2 })
+                                    .to_string()
+                                    .parse()
+                                    .unwrap(),
+                            );
+                            h.insert("x-user-roles", "admin".parse().unwrap());
+                            h.insert(
+                                "x-user-permissions",
+                                if n == 3 {
+                                    "chat:summary:read"
+                                } else {
+                                    "chat:summary:read,chat:chat:read"
+                                }
+                                .parse()
+                                .unwrap(),
+                            );
+                            (
+                                if n == 1 {
+                                    axum::http::StatusCode::FORBIDDEN
+                                } else {
+                                    axum::http::StatusCode::OK
+                                },
+                                h,
+                            )
+                        }
+                    }),
+                ),
+            )
+            .await
+            .unwrap()
+        });
+        let now = chrono::Utc::now();
+        let mut g = EvidenceGrant {
+            iss: "infera-profile".into(),
+            aud: Source::Chat,
+            deployment_id: "native-fixture".into(),
+            service_user_id: Uuid::from_u128(2),
+            subject_user_id: Uuid::from_u128(1),
+            role_id: Uuid::from_u128(3),
+            run_id: Uuid::new_v4(),
+            config_revision: 1,
+            tools: vec![
+                "get_subject_context".into(),
+                "get_activity_overview".into(),
+                "list_activity".into(),
+                "get_activity_detail".into(),
+            ],
+            categories: vec!["activity"].into_iter().map(str::to_owned).collect(),
+            scope: Scope::Subject,
+            allow_text: false,
+            window_start: now - chrono::Duration::days(30),
+            cutoff: now + chrono::Duration::seconds(3),
+            native_scope_id: Some(Uuid::from_u128(20)),
+            iat: now.timestamp(),
+            exp: now.timestamp() + 600,
+        };
+        let reader = Reader(db.clone());
+        let overview = reader
+            .read(g.clone(), "get_activity_overview".into(), args(json!({})))
+            .await
+            .unwrap();
+        assert_eq!(overview.coverage.record_count, 105);
+        assert_eq!(overview.aggregates["chat.activity.count"], json!(105));
+        let first = reader
+            .read(g.clone(), "list_activity".into(), args(json!({"limit":2})))
+            .await
+            .unwrap();
+        assert_eq!(first.records.len(), 2);
+        assert!(first.truncated);
+        assert_eq!(first.aggregates, overview.aggregates);
+        let cursor = first.next_cursor.clone().unwrap();
+        let next = reader
+            .read(
+                g.clone(),
+                "list_activity".into(),
+                args(json!({"limit":2,"cursor":cursor})),
+            )
+            .await
+            .unwrap();
+        assert!(!first.records.iter().any(|a| next
+            .records
+            .iter()
+            .any(|b| a.id == b.id && a.category == b.category)));
+        assert!(!serde_json::to_string(&first).unwrap().contains("PRIVATE"));
+        let mut empty = g.clone();
+        empty.subject_user_id = Uuid::from_u128(999);
+        assert_eq!(
+            reader
+                .read(empty, "get_activity_overview".into(), args(json!({})))
+                .await
+                .unwrap()
+                .coverage
+                .status,
+            CoverageStatus::Empty
+        );
+        let signing = SigningKey::from_bytes(&[42; 32]);
+        std::env::set_var(
+            "SUMMARY_VERIFYING_KEY",
+            URL_SAFE_NO_PAD.encode(signing.verifying_key().to_bytes()),
+        );
+        std::env::set_var("SUMMARY_DEPLOYMENT_ID", "native-fixture");
+        std::env::set_var("SUMMARY_SERVICE_USER_ID", g.service_user_id.to_string());
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}/mcp", listener.local_addr().unwrap());
+        let server_reader = reader.clone();
+        let server_task = tokio::spawn(async move {
+            axum::serve(listener, server::router(server_reader))
+                .await
+                .unwrap()
+        });
+        let secret = URL_SAFE_NO_PAD.encode(signing.to_bytes());
+        let token = sign_grant(&g, &secret).unwrap();
+        let client = ()
+            .serve(StreamableHttpClientTransport::with_client(
+                reqwest::Client::new(),
+                StreamableHttpClientTransportConfig::with_uri(url.clone())
+                    .auth_header(token.clone()),
+            ))
+            .await
+            .unwrap();
+        let tools = client.list_all_tools().await.unwrap();
+        assert_eq!(tools.len(), 4);
+        assert!(tools.iter().all(|t| t.output_schema.is_some()));
+        let request = || CallToolRequestParam {
+            name: "get_activity_overview".into(),
+            arguments: Some(json!({}).as_object().unwrap().clone()),
+        };
+        let response = client.call_tool(request()).await.unwrap();
+        let envelope: EvidenceEnvelope =
+            serde_json::from_value(response.structured_content.unwrap()).unwrap();
+        assert_eq!(envelope.aggregates, overview.aggregates);
+        let forged = client
+            .call_tool(CallToolRequestParam {
+                name: "list_activity".into(),
+                arguments: Some(
+                    json!({"subject_user_id":Uuid::from_u128(999)})
+                        .as_object()
+                        .unwrap()
+                        .clone(),
+                ),
+            })
+            .await;
+        assert!(forged.is_err());
+        for mode in [1, 2, 3] {
+            state.store(mode, Ordering::SeqCst);
+            let r = client.call_tool(request()).await.unwrap();
+            assert_eq!(r.is_error, Some(true));
+            assert_eq!(r.structured_content.unwrap()["status"], "forbidden");
+        }
+        state.store(0, Ordering::SeqCst);
+        let http = reqwest::Client::new();
+        assert_eq!(
+            http.post(&url)
+                .bearer_auth(format!("{token}x"))
+                .send()
+                .await
+                .unwrap()
+                .status(),
+            401
+        );
+        assert_eq!(
+            http.post(&url)
+                .bearer_auth(&token)
+                .header("origin", "https://untrusted.invalid")
+                .send()
+                .await
+                .unwrap()
+                .status(),
+            403
+        );
+        // Signed identity/scope claims are verified on every HTTP request.
+        let mut wrong = g.clone();
+        wrong.deployment_id = "another-project".into();
+        let wrong_project = sign_grant(&wrong, &secret).unwrap();
+        assert_eq!(
+            http.post(&url)
+                .bearer_auth(wrong_project)
+                .send()
+                .await
+                .unwrap()
+                .status(),
+            401
+        );
+        wrong = g.clone();
+        wrong.exp = chrono::Utc::now().timestamp() - 1;
+        assert_eq!(
+            http.post(&url)
+                .bearer_auth(sign_grant(&wrong, &secret).unwrap())
+                .send()
+                .await
+                .unwrap()
+                .status(),
+            401
+        );
+        wrong = g.clone();
+        wrong.aud = Source::Lms;
+        assert_eq!(
+            http.post(&url)
+                .bearer_auth(sign_grant(&wrong, &secret).unwrap())
+                .send()
+                .await
+                .unwrap()
+                .status(),
+            401
+        );
+        let before = checks.load(Ordering::SeqCst);
+        let forbidden_category = client
+            .call_tool(CallToolRequestParam {
+                name: "list_activity".into(),
+                arguments: Some(
+                    json!({"category":"not-selected"})
+                        .as_object()
+                        .unwrap()
+                        .clone(),
+                ),
+            })
+            .await
+            .unwrap();
+        assert_eq!(forbidden_category.is_error, Some(true));
+        assert_eq!(
+            checks.load(Ordering::SeqCst),
+            before,
+            "disabled categories never reach the evidence reader"
+        );
+        // A native subset must be denied, not presented as complete totals or empty.
+        db.execute_unprepared(include_str!("../restrict.sql"))
+            .await
+            .unwrap();
+        g.cutoff = chrono::Utc::now() + chrono::Duration::seconds(3);
+        assert_eq!(
+            reader
+                .read(g.clone(), "get_activity_overview".into(), args(json!({})))
+                .await
+                .unwrap_err(),
+            "forbidden_native_record_scope"
+        );
+        let pending = db
+            .query_one(Statement::from_string(
+                DbBackend::Postgres,
+                "SELECT count(*) AS n FROM summary_activity_outbox",
+            ))
+            .await
+            .unwrap()
+            .unwrap()
+            .try_get::<i64>("", "n")
+            .unwrap();
+        assert!(pending > 0);
+        assert!(checks.load(Ordering::SeqCst) >= 9);
+        client.cancel().await.unwrap();
+        server_task.abort();
+        identity_task.abort();
+    }
+}
