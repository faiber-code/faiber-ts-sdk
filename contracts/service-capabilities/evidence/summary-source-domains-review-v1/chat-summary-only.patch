+CREATE TABLE summary_activity_outbox (
+ id UUID PRIMARY KEY DEFAULT gen_random_uuid(), source TEXT NOT NULL, category TEXT NOT NULL,
+ subject_user_ids JSONB NOT NULL, previous_subject_user_ids JSONB NOT NULL,
+ relationship_change BOOLEAN NOT NULL DEFAULT false, revision TEXT NOT NULL, occurred_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+ sent_at TIMESTAMPTZ, lease_token UUID, lease_until TIMESTAMPTZ, attempts INT NOT NULL DEFAULT 0
+);
+CREATE INDEX ix_summary_activity_pending ON summary_activity_outbox(occurred_at) WHERE sent_at IS NULL;
+CREATE FUNCTION summary_activity_subjects(data JSONB) RETURNS JSONB LANGUAGE sql IMMUTABLE AS $$
+ SELECT COALESCE(jsonb_agg(DISTINCT value),'[]'::jsonb) FROM jsonb_each_text(data)
+ WHERE key IN ('user_id','student_id','owner_id','teacher_user_id','support_user_id','consultant_user_id','creator_user_id','sender_id','profile_id','actor_id','author_id','reporter_id')
+ AND value ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
+$$;
+CREATE FUNCTION summary_activity_capture() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE before_row JSONB:='{}'; after_row JSONB:='{}'; before_ids JSONB; after_ids JSONB; related JSONB; row_data JSONB;
+BEGIN
+ IF TG_OP<>'INSERT' THEN before_row:=to_jsonb(OLD); END IF;
+ IF TG_OP<>'DELETE' THEN after_row:=to_jsonb(NEW); END IF;
+ before_ids:=summary_activity_subjects(before_row);after_ids:=summary_activity_subjects(after_row);
+ IF TG_TABLE_NAME='classrooms' AND to_regclass('classroom_users') IS NOT NULL THEN
+  EXECUTE 'SELECT COALESCE(jsonb_agg(user_id),''[]'') FROM classroom_users WHERE classroom_id::text=$1' INTO related USING COALESCE(after_row->>'id',before_row->>'id');before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+ END IF;
+ IF TG_TABLE_NAME='rooms' AND to_regclass('room_clients') IS NOT NULL THEN
+  EXECUTE 'SELECT COALESCE(jsonb_agg(profile_id),''[]'') FROM room_clients WHERE room_id::text=$1' INTO related USING COALESCE(after_row->>'id',before_row->>'id');before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+ END IF;
+ IF TG_TABLE_NAME='chat_conversations' AND to_regclass('chat_conversation_members') IS NOT NULL THEN
+  EXECUTE 'SELECT COALESCE(jsonb_agg(user_id),''[]'') FROM chat_conversation_members WHERE conversation_id::text=$1' INTO related USING COALESCE(after_row->>'id',before_row->>'id');before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+ END IF;
+ FOR row_data IN SELECT before_row UNION ALL SELECT after_row LOOP
+  IF row_data->>'room_client_id' IS NOT NULL AND to_regclass('room_clients') IS NOT NULL THEN
+   EXECUTE 'SELECT summary_activity_subjects(to_jsonb(c)) FROM room_clients c WHERE c.id::text=$1' INTO related USING row_data->>'room_client_id';before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+  END IF;
+  IF row_data->>'classroom_session_id' IS NOT NULL AND to_regclass('classroom_sessions') IS NOT NULL AND to_regclass('classrooms') IS NOT NULL THEN
+   EXECUTE 'SELECT summary_activity_subjects(to_jsonb(c)||to_jsonb(s)) FROM classroom_sessions s JOIN classrooms c ON c.id=s.classroom_id WHERE s.id::text=$1' INTO related USING row_data->>'classroom_session_id';
+   before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+  END IF;
+  IF row_data->>'exam_session_id' IS NOT NULL AND to_regclass('exam_sessions') IS NOT NULL AND to_regclass('classrooms') IS NOT NULL THEN
+   EXECUTE 'SELECT summary_activity_subjects(to_jsonb(c)) FROM exam_sessions s JOIN classrooms c ON c.id=s.classroom_id WHERE s.id::text=$1' INTO related USING row_data->>'exam_session_id';
+   before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+  END IF;
+  IF row_data->>'project_id' IS NOT NULL AND to_regclass('task_project_access_grants') IS NOT NULL THEN
+   EXECUTE 'SELECT COALESCE(jsonb_agg(user_id),''[]'') FROM task_project_access_grants WHERE project_id::text=$1 AND (valid_from IS NULL OR valid_from<=now()) AND (expires_at IS NULL OR expires_at>now())' INTO related USING row_data->>'project_id';
+   before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+  END IF;
+  IF row_data->>'classroom_id' IS NOT NULL AND to_regclass('classrooms') IS NOT NULL THEN
+   EXECUTE 'SELECT summary_activity_subjects(to_jsonb(c)) FROM classrooms c WHERE c.id::text=$1' INTO related USING row_data->>'classroom_id';
+   before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+  END IF;
+  IF row_data->>'work_item_id' IS NOT NULL AND to_regclass('task_work_items') IS NOT NULL THEN
+   EXECUTE 'SELECT summary_activity_subjects(to_jsonb(w)) FROM task_work_items w WHERE w.id::text=$1' INTO related USING row_data->>'work_item_id';
+   before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+  END IF;
+  IF row_data->>'conversation_id' IS NOT NULL AND to_regclass('chat_conversation_members') IS NOT NULL THEN
+   EXECUTE 'SELECT COALESCE(jsonb_agg(user_id),''[]'') FROM chat_conversation_members WHERE conversation_id::text=$1 AND left_at IS NULL' INTO related USING row_data->>'conversation_id';
+   before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+  END IF;
+  IF row_data->>'room_id' IS NOT NULL AND to_regclass('room_clients') IS NOT NULL THEN
+   EXECUTE 'SELECT COALESCE(jsonb_agg(profile_id),''[]'') FROM room_clients WHERE room_id::text=$1' INTO related USING row_data->>'room_id';
+   before_ids:=before_ids||COALESCE(related,'[]');after_ids:=after_ids||COALESCE(related,'[]');
+  END IF;
+ END LOOP;
+ INSERT INTO summary_activity_outbox(source,category,subject_user_ids,previous_subject_user_ids,relationship_change,revision)
+ VALUES(TG_ARGV[0],TG_ARGV[1],after_ids,before_ids,(summary_activity_subjects(before_row) IS DISTINCT FROM summary_activity_subjects(after_row)) OR TG_TABLE_NAME IN ('classrooms','classroom_users','room_clients','rooms','chat_conversation_members','chat_conversations','task_work_item_people','task_project_access_grants','task_work_item_access_grants'),txid_current()::text||':'||clock_timestamp()::text);
+ IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;
+END $$;
diff --git a/shared/infera-summary-sdk/src/query.rs b/shared/infera-summary-sdk/src/query.rs
new file mode 100644
index 0000000..2f1d194
--- /dev/null
+++ b/shared/infera-summary-sdk/src/query.rs
@@ -0,0 +1,223 @@
+use crate::*;
+use sea_orm::{ConnectionTrait, DatabaseBackend, Statement, Value as SqlValue};
+use serde_json::{json, Value};
+
+/// A native policy may authorize only part of the requested signed scope. Reject
+/// that case explicitly instead of publishing partial/zero totals as complete.
+/// Domain SQL includes a private `principal_authorized` boolean; it is never
+/// returned in the evidence envelope. Callers still filter it before reading.
+pub async fn ensure_native_coverage<C: ConnectionTrait>(
+    db: &C,
+    g: &EvidenceGrant,
+    args: &ActivityArguments,
+    domain_sql: &str,
+) -> Result<(), String> {
+    if args
+        .text_offset
+        .is_some_and(|offset| !g.allow_text || offset > 1000000)
+    {
+        return Err("forbidden_text_segment".into());
+    }
+    let sql = domain_sql.replace(
+        "/*SUMMARY_TEXT_OFFSET*/0",
+        &args.text_offset.unwrap_or(0).to_string(),
+    );
+    let values: Vec<SqlValue> = vec![
+        g.subject_user_id.into(),
+        g.service_user_id.into(),
+        g.native_scope_id.into(),
+        json!(g.scope).as_str().unwrap().to_string().into(),
+        g.window_start.into(),
+        g.cutoff.into(),
+        json!(g.categories).into(),
+        g.allow_text.into(),
+    ];
+    let query=format!("WITH parameters AS(SELECT $1::uuid AS subject,$2::uuid AS principal,$3::uuid AS native_scope,$4::text AS scope,$5::timestamptz AS start_at,$6::timestamptz AS cutoff,$7::jsonb AS categories,$8::boolean AS allow_text) SELECT COALESCE(bool_or(NOT COALESCE(principal_authorized,false)),false) AS denied FROM ({sql}) native_rows WHERE category IN(SELECT jsonb_array_elements_text($7::jsonb)) AND occurred_at >= $5 AND occurred_at <= $6");
+    let row = db
+        .query_one(Statement::from_sql_and_values(
+            DatabaseBackend::Postgres,
+            query,
+            values,
+        ))
+        .await
+        .map_err(|_| "native_coverage_check_unavailable")?
+        .ok_or("native_coverage_check_unavailable")?;
+    if row
+        .try_get::<bool>("", "denied")
+        .map_err(|_| "native_coverage_check_unavailable")?
+    {
+        return Err("forbidden_native_record_scope".into());
+    }
+    Ok(())
+}
+/// Domain SQL must return (id text,category text,version text,occurred_at timestamptz,data jsonb).
+/// Parameters 1..8 are fixed here; adapters cannot accept model-supplied predicates.
+pub async fn evidence_with_aggregates<C: ConnectionTrait>(
+    db: &C,
+    g: &EvidenceGrant,
+    tool: &str,
+    args: ActivityArguments,
+    domain_sql: &str,
+    aggregates_sql: &str,
+) -> Result<EvidenceEnvelope, String> {
+    if args.text_offset.is_some()
+        && (tool != "get_activity_detail" || !g.allow_text || args.text_offset.unwrap() > 1000000)
+    {
+        return Err("forbidden_text_segment".into());
+    }
+    let domain_sql = domain_sql.replace(
+        "/*SUMMARY_TEXT_OFFSET*/0",
+        &args.text_offset.unwrap_or(0).to_string(),
+    );
+    let mut values: Vec<SqlValue> = vec![
+        g.subject_user_id.into(),
+        g.service_user_id.into(),
+        g.native_scope_id.into(),
+        json!(g.scope).as_str().unwrap().to_string().into(),
+        g.window_start.into(),
+        g.cutoff.into(),
+        json!(g.categories).into(),
+        g.allow_text.into(),
+    ];
+    let prefix=format!("WITH parameters AS (SELECT $1::uuid AS subject,$2::uuid AS principal,$3::uuid AS native_scope,$4::text AS scope,$5::timestamptz AS start_at,$6::timestamptz AS cutoff,$7::jsonb AS categories,$8::boolean AS allow_text), domain AS ({domain_sql}), scoped AS (SELECT * FROM domain WHERE category IN (SELECT jsonb_array_elements_text($7::jsonb)) AND occurred_at >= $5 AND occurred_at <= $6)");
+    let aggregate_sql=format!("{prefix} SELECT category,COUNT(*)::bigint AS count,COALESCE(encode(sha256(convert_to(string_agg(encode(sha256(convert_to(id||version||data::text,'UTF8')),'hex'),'' ORDER BY id),'UTF8')),'hex'),'empty') AS revision FROM scoped GROUP BY category ORDER BY category");
+    let rows = db
+        .query_all(Statement::from_sql_and_values(
+            DatabaseBackend::Postgres,
+            aggregate_sql,
+            values.clone(),
+        ))
+        .await
+        .map_err(|_| "evidence_query_failed")?;
+    let mut aggregates = std::collections::BTreeMap::new();
+    let mut count = 0i64;
+    let mut revisions = vec![];
+    for row in rows {
+        let category: String = row
+            .try_get("", "category")
+            .map_err(|_| "invalid_evidence")?;
+        let n: i64 = row.try_get("", "count").map_err(|_| "invalid_evidence")?;
+        count += n;
+        aggregates.insert(format!("{}.{}.count", g.aud.key(), category), json!(n));
+        revisions.push((
+            category,
+            n,
+            row.try_get::<String>("", "revision").unwrap_or_default(),
+        ));
+    }
+    for category in &g.categories {
+        aggregates
+            .entry(format!("{}.{}.count", g.aud.key(), category))
+            .or_insert(json!(0));
+    }
+    if !aggregates_sql.trim().is_empty() {
+        for row in db
+            .query_all(Statement::from_sql_and_values(
+                DatabaseBackend::Postgres,
+                format!("{prefix} {aggregates_sql}"),
+                values.clone(),
+            ))
+            .await
+            .map_err(|_| "evidence_aggregate_failed")?
+        {
+            let key = row
+                .try_get::<String>("", "key")
+                .map_err(|_| "invalid_aggregate")?;
+            if key
+                .split('.')
+                .nth(1)
+                .is_some_and(|category| g.categories.iter().any(|c| c == category))
+            {
+                aggregates.insert(
+                    key,
+                    row.try_get::<Value>("", "value")
+                        .map_err(|_| "invalid_aggregate")?,
+                );
+            }
+        }
+    }
+    let mut records = vec![];
+    let mut next_cursor = None;
+    let mut truncated = false;
+    if matches!(tool, "list_activity" | "get_activity_detail") {
+        if tool == "get_activity_detail" && args.record_id.is_none() {
+            return Err("record_id_required".into());
+        }
+        if args.cursor.as_ref().is_some_and(|s| s.len() > 256)
+            || args.record_id.as_ref().is_some_and(|s| s.len() > 128)
+        {
+            return Err("invalid_cursor_or_record".into());
+        }
+        values.extend([
+            args.category.into(),
+            args.record_id.into(),
+            args.cursor.into(),
+            (args.limit as i64 + 1).into(),
+        ]);
+        let q=format!("{prefix} SELECT * FROM scoped WHERE ($9::text IS NULL OR category=$9) AND ($10::text IS NULL OR id=$10) AND ($11::text IS NULL OR category||':'||id>$11) ORDER BY category,id LIMIT $12");
+        let rows = db
+            .query_all(Statement::from_sql_and_values(
+                DatabaseBackend::Postgres,
+                q,
+                values,
+            ))
+            .await
+            .map_err(|_| "evidence_query_failed")?;
+        for row in rows.iter().take(args.limit as usize) {
+            let id: String = row.try_get("", "id").map_err(|_| "invalid_evidence")?;
+            let category: String = row
+                .try_get("", "category")
+                .map_err(|_| "invalid_evidence")?;
+            let version: String = row.try_get("", "version").map_err(|_| "invalid_evidence")?;
+            let data: Value = row.try_get("", "data").map_err(|_| "invalid_evidence")?;
+            let version = format!("{version}:{}", crate::fingerprint(&data));
+            records.push(EvidenceRecord {
+                reference: format!("{}:{category}:{id}:{version}", g.aud.key()),
+                id,
+                category,
+                version,
+                occurred_at: row
+                    .try_get("", "occurred_at")
+                    .map_err(|_| "invalid_evidence")?,
+                data,
+            });
+        }
+        truncated = rows.len() > args.limit as usize;
+        if truncated {
+            next_cursor = records.last().map(|r| format!("{}:{}", r.category, r.id));
+        }
+    }
+    Ok(EvidenceEnvelope {
+        contract_version: "1".into(),
+        source: g.aud,
+        subject_user_id: g.subject_user_id,
+        scope: g.scope,
+        window_start: g.window_start,
+        cutoff: g.cutoff,
+        coverage: Coverage {
+            source: g.aud,
+            status: if count == 0 {
+                CoverageStatus::Empty
+            } else {
+                CoverageStatus::Available
+            },
+            revision: crate::fingerprint(&revisions),
+            reason: None,
+            record_count: count,
+        },
+        aggregates,
+        records,
+        next_cursor,
+        truncated,
+    })
+}
+
+pub async fn evidence<C: ConnectionTrait>(
+    db: &C,
+    g: &EvidenceGrant,
+    tool: &str,
+    args: ActivityArguments,
+    domain_sql: &str,
+) -> Result<EvidenceEnvelope, String> {
+    evidence_with_aggregates(db, g, tool, args, domain_sql, "").await
+}
diff --git a/shared/infera-summary-sdk/src/result.rs b/shared/infera-summary-sdk/src/result.rs
new file mode 100644
index 0000000..cf35420
