--- /dev/null
+++ b/tests/run-summary-retirement-http.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+set -euo pipefail
+repo="$(cd "$(dirname "$0")/.." && pwd)"
+: "${SUMMARY_LMS_SDK_ENTRY:?Set isolated compiled @faiber/faiber-lms dist/index.js}"
+project="lms-retirement-http-$$"
+compose=(docker compose -p "$project" -f "$repo/tests/summary-retirement-services.compose.yml")
+trap '"${compose[@]}" down --remove-orphans' EXIT
+"${compose[@]}" up -d --wait --pull never
+pg_port="$("${compose[@]}" port postgres 5432 | sed 's/.*://')"
+rmq_port="$("${compose[@]}" port rabbitmq 5672 | sed 's/.*://')"
+export SUMMARY_TEST_DATABASE_URL="postgres://postgres:summary-test@127.0.0.1:$pg_port/summary_test"
+export SUMMARY_TEST_BROKER_URL="amqp://guest:guest@127.0.0.1:$rmq_port/%2f"
+export SUMMARY_LMS_RETIREMENT_CONSUMER="$repo/tests/summary-retirement-http.mjs"
+cargo test --manifest-path "$repo/Cargo.toml" --locked --offline --test summary_retirement_http -- --ignored --nocapture
diff --git a/tests/summary-retirement-http.mjs b/tests/summary-retirement-http.mjs
new file mode 100644
index 0000000..dbc4ebc
--- /dev/null
+++ b/tests/summary-retirement-http.mjs
@@ -0,0 +1,23 @@
+// Retired wrappers do not exist: use the actual SDK's generic transport to probe old URLs.
+import assert from 'node:assert/strict';import {pathToFileURL} from 'node:url';
+const {LmsApi,FaiberClient}=await import(pathToFileURL(process.env.SUMMARY_LMS_SDK_ENTRY).href);
+const f=JSON.parse(process.env.SUMMARY_LMS_RETIREMENT_FIXTURE);let assertions=0;const observations=[];
+function check(v,message){assert.ok(v,message);assertions++;}
+const permissions='lms:config:read,lms:config:update,lms:ai_summary:read,lms:ai_summary:read_own,lms:ai_summary:read_related,lms:ai_summary:manage';
+const api=new LmsApi(new FaiberClient('lms',{domains:{lms:f.url},axios:{proxy:false,timeout:10000,headers:{'x-user-id':f.user_id,'x-user-roles':'admin','x-user-permissions':permissions}}}));
+check(api.aiSummaries===undefined&&api.aiSummary===undefined,'no obsolete LMS summary facade');
+check(![...Object.getOwnPropertyNames(api),...Object.getOwnPropertyNames(Object.getPrototypeOf(api)),...Object.getOwnPropertyNames(Object.getPrototypeOf(api.operations))].some(k=>/ai.?summar/i.test(k)),'no retired summary facade or operation method exposed');
+const health=await api.request({method:'GET',url:'/health'});check(health.status===200&&health.data.status==='success','actual LMS server health');
+const self=await api.request({method:'GET',url:'/api/v1/auth/self'});check(self.status===200&&self.data.data.user_id===f.user_id,'valid trusted actor extracted');check(self.data.data.permissions.includes('lms:ai_summary:manage'),'legacy grants are present so absence is not permission denial');
+for(const url of ['/api/v1/config/grades','/api/v1/evaluations/settings']){const r=await api.request({method:'GET',url});check(r.status===200&&r.data.status==='success','ordinary education/config endpoint preserved: '+url);}
+const openapi=await api.request({method:'GET',url:'/api/openapi.json'});check(!Object.keys(openapi.data.paths).some(p=>p.includes('ai-summaries')),'generated OpenAPI has no retired routes');
+const roles=['student','teacher','support'].map(role=>({role,enabled:false,model_ref:'fixture-retired',language:'fa',guidance:'fixture',quiet_minutes:10,max_wait_minutes:60}));
+const operations=[['GET','/settings',null,null],['PUT','/settings',{globally_enabled:true,concurrency_limit:1,roles},null],['GET','/models',null,null],['GET','/latest',null,{role:'student',user_id:f.user_id}],['GET','/jobs',null,{role:'student',page:1,page_size:20}],['GET','/summaries',null,{role:'student',page:1,page_size:20}],['POST','/refresh',{role:'student',user_ids:[f.user_id]},null],['POST',`/users/${f.user_id}/student/refresh`,null,null]];
+function classify(r){const contentType=String(r.headers['content-type']??'');if([401,403].includes(r.status))return'auth';if(r.status===404)return'not_found';if(r.status===405)return'method_not_allowed';if(typeof r.data==='string'&&r.data.includes(f.spa_marker)&&contentType.includes('text/html'))return'spa_fallback';if(contentType.includes('json')||typeof r.data==='object')return'json_api';return'other';}
+for(const phase of ['index_present','index_absent']){
+ if(phase==='index_absent'){const r=await fetch(f.url+'/__fixture/remove-index',{method:'POST'});check(r.ok,'remove only test SPA file');}
+ for(const[method,path,data,params]of operations){const r=await api.request({method,url:'/api/v1/ai-summaries'+path,...(data?{data}:{}),...(params?{params}:{}),validateStatus:()=>true});const kind=classify(r);observations.push({phase,method,path:'/api/v1/ai-summaries'+path,status:r.status,classification:kind,content_type:r.headers['content-type']??null,allow:r.headers.allow??null,body:r.data});check(kind!=='auth','not a login/permission response');check(kind!=='json_api','no old JSON summary API or compatibility proxy');
+ if(method==='GET')check(kind===(phase==='index_present'?'spa_fallback':'not_found'),'GET uses generic SPA fallback only when index exists');else check(kind==='method_not_allowed','removed non-GET uses generic GET fallback405');
+ }
+}
+console.log(JSON.stringify({status:'passed',assertions,retired_operations:8,observations,scope:'actual compiled SDK generic transport to mounted immutable LMS router; trusted gateway actor fixture; real PostgreSQL full historical migrations and RabbitMQ; synthetic SPA index and Profile name lookup only; no model/provider/billing'},null,2));
