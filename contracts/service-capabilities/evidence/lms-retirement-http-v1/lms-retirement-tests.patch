diff --git a/tests/summary_retirement_http.rs b/tests/summary_retirement_http.rs
new file mode 100644
index 0000000..1f8a55c
--- /dev/null
+++ b/tests/summary_retirement_http.rs
@@ -0,0 +1,143 @@
+//! Real HTTP/compiled SDK retirement check. No production summaries or live identities.
+use axum::{routing::post, Json, Router};
+use infera_lms::{router, state::AppState};
+use migration::{Migrator, MigratorTrait};
+use sea_orm::{ConnectionTrait, Database, DatabaseBackend, Statement};
+use serde_json::{json, Value};
+use std::sync::Arc;
+use uuid::Uuid;
+async fn serve(app: Router) -> String {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    url
+}
+async fn legacy_snapshot(db: &sea_orm::DatabaseConnection) -> Value {
+    let mut values = serde_json::Map::new();
+    for table in [
+        "lms_ai_summary_settings",
+        "lms_ai_performance_summaries",
+        "lms_ai_summary_jobs",
+    ] {
+        let row=db.query_one(Statement::from_string(DatabaseBackend::Postgres,format!("SELECT COUNT(*)::bigint AS n,md5(COALESCE(string_agg(to_jsonb(t)::text,'' ORDER BY to_jsonb(t)::text),'')) AS fingerprint FROM {table} t"))).await.unwrap().unwrap();
+        values.insert(table.into(),json!({"count":row.try_get::<i64>("","n").unwrap(),"fingerprint":row.try_get::<String>("","fingerprint").unwrap()}));
+    }
+    json!(values)
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+#[ignore = "requires dedicated SUMMARY_TEST_DATABASE_URL, SUMMARY_TEST_BROKER_URL and compiled SDK entry"]
+async fn retired_summary_routes_are_not_json_apis_and_legacy_storage_is_inert() {
+    let database = std::env::var("SUMMARY_TEST_DATABASE_URL").unwrap();
+    assert!(database.contains("summary_test"));
+    let db = Database::connect(&database).await.unwrap();
+    // Whole historical migration chain, including the combined summary/evaluation migration.
+    Migrator::up(&db, None).await.unwrap();
+    let names = db
+        .query_all(Statement::from_string(
+            DatabaseBackend::Postgres,
+            "SELECT version FROM seaql_migrations ORDER BY version",
+        ))
+        .await
+        .unwrap()
+        .into_iter()
+        .map(|r| r.try_get::<String>("", "version").unwrap())
+        .collect::<Vec<_>>();
+    assert!(names
+        .iter()
+        .any(|n| n.contains("000021_ai_performance_summaries")));
+    assert!(names
+        .iter()
+        .any(|n| n.contains("000020_session_evaluations")));
+    let user = Uuid::new_v4();
+    db.execute(Statement::from_sql_and_values(DatabaseBackend::Postgres,"INSERT INTO lms_ai_performance_summaries(subject_user_id,role,state,freshness,language,model_ref,evidence_fingerprint,evidence_cutoff,source_revision,config_revision,result) VALUES($1,'student','completed','fresh','fa','fixture-retired','fixture',now(),1,1,$2)",vec![user.into(),json!({"marker":"legacy-storage-must-remain"}).into()])).await.unwrap();
+    db.execute(Statement::from_sql_and_values(DatabaseBackend::Postgres,"INSERT INTO lms_ai_summary_jobs(subject_user_id,role,first_changed_at,last_changed_at,due_at) VALUES($1,'student',now(),now(),now())",vec![user.into()])).await.unwrap();
+    let before = legacy_snapshot(&db).await;
+    let profile = serve(Router::new().route(
+        "/get",
+        post(|| async { Json(json!({"data":{"profiles":[]}})) }),
+    ))
+    .await;
+    for key in [
+        "PROFILE_BASE_URL",
+        "DRM_BASE_URL",
+        "AGENTIC_URL",
+        "AGENTIC_BASE_URL",
+        "SUMMARY_AGENTIC_URL",
+    ] {
+        std::env::set_var(key, &profile);
+    }
+    std::env::set_var("FLOW_EVENTS_ENABLED", "false");
+    let connection = Arc::new(
+        lapin::Connection::connect(
+            &std::env::var("SUMMARY_TEST_BROKER_URL").unwrap(),
+            lapin::ConnectionProperties::default(),
+        )
+        .await
+        .unwrap(),
+    );
+    let channel = Arc::new(connection.create_channel().await.unwrap());
+    let flow = infera_flow_sdk::setup_flow_sdk(channel.clone(), "lms-retirement-local-test").await;
+    let state = AppState {
+        db: Arc::new(db),
+        broker_channel: channel,
+        dev: Arc::new(false),
+        flow_middleware: flow.middleware,
+        profile_client: Arc::new(infera_lms::profile::ProfileClient::from_env()),
+        drm_client: Arc::new(infera_lms::drm::DrmClient::from_env()),
+    };
+    // The production fallback reads panel/dist/index.html relative to cwd. Test it
+    // with a deterministic index, then with that file absent. Production source untouched.
+    let original = std::env::current_dir().unwrap();
+    let dir = std::env::temp_dir().join(format!("lms-retirement-{}", Uuid::new_v4().simple()));
+    std::fs::create_dir_all(dir.join("panel/dist")).unwrap();
+    let index = dir.join("panel/dist/index.html");
+    let marker = "<!doctype html><html><body>LMS_RETIREMENT_SPA_FIXTURE</body></html>";
+    std::fs::write(&index, marker).unwrap();
+    std::env::set_current_dir(&dir).unwrap();
+    let app = Router::new()
+        .merge(router::routes(&state))
+        .with_state(state.clone())
+        .merge(infera_lms::summary_evidence::routes(state.clone()));
+    let control = Router::new().route(
+        "/__fixture/remove-index",
+        post(move || {
+            let index = index.clone();
+            async move {
+                std::fs::remove_file(index).unwrap();
+                Json(json!({"ok":true}))
+            }
+        }),
+    );
+    let url = serve(app.merge(control)).await;
+    let output = std::process::Command::new("node")
+        .arg(std::env::var("SUMMARY_LMS_RETIREMENT_CONSUMER").unwrap())
+        .env(
+            "SUMMARY_LMS_RETIREMENT_FIXTURE",
+            json!({"url":url,"user_id":user,"spa_marker":"LMS_RETIREMENT_SPA_FIXTURE"}).to_string(),
+        )
+        .output()
+        .unwrap();
+    println!("{}", String::from_utf8_lossy(&output.stdout));
+    eprintln!("{}", String::from_utf8_lossy(&output.stderr));
+    let after = legacy_snapshot(state.db.as_ref()).await;
+    println!(
+        "LEGACY_STORAGE {}",
+        json!({"before":before,"after":after,"migration_count":names.len(),"migrations":names})
+    );
+    std::env::set_current_dir(original).unwrap();
+    std::fs::remove_dir_all(dir).unwrap();
+    assert_eq!(
+        before, after,
+        "Retired requests must not read-modify/queue legacy summaries"
+    );
+    assert!(
+        output.status.success(),
+        "compiled SDK retirement consumer failed: {}",
+        output.status
+    );
+    state.db.close_by_ref().await.unwrap();
+    connection
+        .close(200, "local retirement test finished")
+        .await
+        .unwrap();
+}
