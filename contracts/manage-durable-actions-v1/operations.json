  "operations": [
    {
      "name": "getAgentActionCapabilities",
      "method": "GET",
      "path": "/api/v1/agent/actions/capabilities",
      "response": "ManageAgentActionCapabilities",
      "parameters": []
    },
    {
      "name": "listAgentActions",
      "method": "GET",
      "path": "/api/v1/agent/threads/{threadId}/actions",
      "response": "ManageAgentActionSummary[]",
      "parameters": [
        "threadId"
      ]
    },
    {
      "name": "getAgentAction",
      "method": "GET",
      "path": "/api/v1/agent/threads/{threadId}/actions/{actionId}",
      "response": "ManageAgentActionReply",
      "parameters": [
        "threadId",
        "actionId"
      ]
    },
    {
      "name": "reviewAgentAction",
      "method": "POST",
      "path": "/api/v1/agent/threads/{threadId}/actions/{actionId}/commands",
      "response": "ManageAgentActionReply",
      "parameters": [
        "threadId",
        "actionId"
      ],
      "input": "ManageAgentActionReviewInput"
    },
    {
      "name": "executeAgentAction",
      "method": "POST",
      "path": "/api/v1/agent/threads/{threadId}/actions/{actionId}/execute",
      "response": "ManageAgentActionReply",
      "parameters": [
        "threadId",
        "actionId"
      ],
      "input": "ManageAgentActionExecuteInput"
    }
  ],
  "scope": "Reviewed five canonical browser operations only. Internal Agentic proof/signing/claim/dispatch/finish are not browser API or exported SDK helpers.",
