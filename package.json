{
  "name": "faiber-ts-sdk-monorepo",
  "version": "1.5.0",
  "description": "Framework-agnostic TypeScript SDK for Faiber services",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "generate": "npm run contracts:extract && npm run contracts:generate && node scripts/generate-manage-actions.mjs",
    "generate:check": "npm run contracts:audit && node scripts/generate-service-operations.mjs service-contracts.json --check && node scripts/generate-manage-actions.mjs --check",
    "contracts:extract": "node scripts/extract-service-contracts.mjs",
    "contracts:generate": "node scripts/generate-service-operations.mjs",
    "contracts:audit": "node scripts/audit-service-contracts.mjs",
    "capabilities:discover": "node scripts/discover-service-capabilities.mjs",
    "capabilities:check": "node scripts/check-service-capabilities.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test:types": "tsc -p tests/tsconfig.json --pretty false",
    "test": "npm run test:types && node --test tests/*.test.mjs",
    "pack:check": "npm run provenance:check && node scripts/pack-check.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "provenance:generate": "node scripts/package-provenance.mjs",
    "provenance:check": "node scripts/package-provenance.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "faiber",
    "sdk",
    "typescript",
    "axios",
    "api-client"
  ]
}
